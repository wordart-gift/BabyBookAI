# Cloudflare Pages response headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Astro fingerprints everything it emits here, so it never changes in place.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The site as Markdown for AI assistants (src/lib/llms.ts). Read by whoever
# asks for it, but never a search result: the pages themselves are.
/llms.txt
  X-Robots-Tag: noindex
/llms-full.txt
  X-Robots-Tag: noindex
/:lang/llms.txt
  X-Robots-Tag: noindex
/:lang/llms-full.txt
  X-Robots-Tag: noindex
/pricing.md
  X-Robots-Tag: noindex
  Content-Type: text/markdown; charset=utf-8

# Preview and branch deploys must never compete with babybookai.com in search.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
