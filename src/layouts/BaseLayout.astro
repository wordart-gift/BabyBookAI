---
import '../styles/global.css';
import { Font } from 'astro:assets';
import SEO, { type Props as SeoProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Sky from '../components/Sky.astro';
import Footer from '../components/Footer.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { SITE } from '../config/site';

export type Props = SeoProps & {
  /** Name of the page for the download links' ?src=; false hides the closing call to action. */
  cta?: string | false;
};

const { cta = 'page', ...seo } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#bfe2f2" />
    {/* Both faces are on the first screen: preloaded with the HTML. Lora is
        only in the book spreads, so it waits until a page uses it. */}
    <Font cssVariable="--font-baloo" preload />
    <Font cssVariable="--font-nunito" preload />
    <Font cssVariable="--font-lora" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...seo} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-surface focus:px-4 focus:py-2"
      >Skip to content</a
    >
    <Sky />
    <Header />
    <main id="main" class="flex-1">
      <slot />
      {cta && <ClosingCta source={cta} />}
    </main>
    <Footer />
  </body>
</html>
