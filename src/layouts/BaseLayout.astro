---
import '../styles/global.css';
import { Font } from 'astro:assets';
import SEO, { type Props as SeoProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Sky from '../components/Sky.astro';
import Perch from '../components/Perch.astro';
import Footer from '../components/Footer.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { COPY } from '../i18n/copy';
import { LOCALES, type Lang } from '../i18n/locales';
import type { PageId } from '../i18n/routes';

export type Props = Omit<SeoProps, 'lang' | 'page'> & {
  lang: Lang;
  /** Which page this is, in every language; null for the 404. */
  page: PageId | null;
  /** Name of the page for the download links' ?src=; false hides the closing call to action. */
  cta?: string | false;
};

const { cta = 'page', lang, page, ...seo } = Astro.props;
const ui = COPY[lang].ui;
---

<!doctype html>
<html lang={LOCALES[lang].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#bfe2f2" />
    {/* Both faces are on the first screen: preloaded with the HTML. Lora is
        only in the book spreads, so it waits until a page uses it. Japanese,
        Korean and Chinese text falls back to the system's own fonts, chosen
        by <html lang>: nothing extra to download, nothing to swap. */}
    <Font cssVariable="--font-baloo" preload />
    <Font cssVariable="--font-nunito" preload />
    <Font cssVariable="--font-lora" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...seo} lang={lang} page={page} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-surface focus:px-4 focus:py-2"
      >{ui.skip}</a
    >
    <Sky />
    <Header lang={lang} page={page} />
    <main id="main" class="relative flex-1">
      <Perch />
      <slot />
      {cta && <ClosingCta source={cta} lang={lang} />}
    </main>
    <Footer lang={lang} page={page} />
  </body>
</html>
