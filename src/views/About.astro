---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Stork from '../components/Stork.astro';
import { APP_ID, ORG_ID, breadcrumbs, mobileApplication } from '../lib/schema';
import { COPY } from '../i18n/copy';
import { plain, rich } from '../i18n/format';
import type { Lang } from '../i18n/locales';
import { path } from '../i18n/routes';

/*
 * Who makes BabyBookAI and how, in facts that can be checked (the app's
 * CLAUDE.md). No founder story: nothing personal is published that Carlos has
 * not written himself.
 */
const { lang } = Astro.props as { lang: Lang };
const { ui, about: t } = COPY[lang];
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: t.crumb, path: path('about', lang) },
];
---

<BaseLayout
  lang={lang}
  page="about"
  title={t.title}
  description={plain(t.description, lang)}
  schema={[breadcrumbs(trail), mobileApplication(lang)]}
  pageType="AboutPage"
  about={[ORG_ID, APP_ID]}
  cta="about"
>
  <Breadcrumbs items={trail} lang={lang} />

  <section class="mx-auto max-w-3xl px-5 pb-16 pt-2 lg:pt-7">
    <p class="font-extrabold uppercase tracking-wider text-teal">{t.eyebrow}</p>
    <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">{t.h1}</h1>
    <div class="mt-6 space-y-5 text-xl text-ink">
      {t.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="band" aria-labelledby="believe">
    <div class="mx-auto max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] px-5">
      <h2 id="believe" class="text-4xl text-teal sm:text-5xl">{t.beliefsTitle}</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {
          t.beliefs.map((b) => (
            <li class="rounded-card bg-paper p-7">
              <h3 class="text-2xl text-ink">{b.title}</h3>
              <p class="mt-3 text-ink-soft" set:html={rich(b.body, lang)} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] px-5 py-20" aria-labelledby="who">
    <div class="grid items-center gap-12 rounded-card bg-teal p-8 text-surface sm:p-12 lg:grid-cols-[auto_1fr]">
      <Stork size={150} swing={false} stage={false} lang={lang} class="mx-auto" />
      <div>
        <h2 id="who" class="text-4xl sm:text-5xl">{t.who.title}</h2>
        <p class="mt-5 max-w-2xl text-lg text-teal-wash" set:html={rich(t.who.body, lang)} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-10 text-center">
    <p class="text-lg text-ink-soft" set:html={rich(t.more, lang)} />
  </section>
</BaseLayout>
