---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import { breadcrumbs, faqPage } from '../lib/schema';
import { SITE } from '../config/site';
import { COPY } from '../i18n/copy';
import { plain, rich } from '../i18n/format';
import type { Lang } from '../i18n/locales';
import { path } from '../i18n/routes';

/*
 * Help for people who already have the app, and every question the site
 * answers elsewhere in one place. Only the support questions go in this
 * page's FAQPage markup: the others already mark up their own pages.
 */
const { lang } = Astro.props as { lang: Lang };
const c = COPY[lang];
const { ui, support: t } = c;
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: t.crumb, path: path('support', lang) },
];
const productFaq = [
  ...c.home.faq,
  ...c.babyPhotoBook.faq.filter((q) => !c.home.faq.some((h) => h.question === q.question)),
];
---

<BaseLayout
  lang={lang}
  page="support"
  title={t.title}
  description={plain(t.description, lang)}
  schema={[breadcrumbs(trail), faqPage(t.faq.map((f) => ({ ...f, answer: plain(f.answer, lang) })))]}
  pageType="ContactPage"
  cta="support"
>
  <Breadcrumbs items={trail} lang={lang} />

  <section class="mx-auto max-w-3xl px-5 pb-12 pt-2 lg:pt-7">
    <p class="font-extrabold uppercase tracking-wider text-teal">{t.eyebrow}</p>
    <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">{t.h1}</h1>
    <p class="mt-6 text-xl text-ink">{t.lead}</p>
    {/* The menu's "Contact" lands here. A plain form: no JS. It posts to the
        Worker in workers/contact, which answers with a redirect back to #sent
        or #failed, and the status lines below show themselves with :target. */}
    <div id="contact" class="mt-8 scroll-mt-6 rounded-card border-2 border-hair bg-surface p-6 sm:p-8">
      <h2 class="text-left text-3xl text-teal sm:text-4xl">{t.form.title}</h2>
      <p id="sent" role="status" class="form-status text-left">{t.form.sent}</p>
      <p id="failed" role="alert" class="form-status form-status-failed text-left" set:html={rich(t.form.failed, lang)} />
      <form method="post" action="/api/contact" class="mt-6 grid gap-5 sm:grid-cols-2">
        <input type="hidden" name="lang" value={lang} />
        <label class="field">
          <span>{t.form.name}</span>
          <input type="text" name="name" autocomplete="name" required maxlength="120" />
        </label>
        <label class="field">
          <span>{t.form.email}</span>
          <input type="email" name="email" autocomplete="email" required maxlength="200" />
        </label>
        <label class="field sm:col-span-2">
          <span>{t.form.subject}</span>
          <input type="text" name="subject" required maxlength="200" />
        </label>
        <label class="field sm:col-span-2">
          <span>{t.form.message}</span>
          <textarea name="message" rows="6" required maxlength="5000"></textarea>
        </label>
        {/* A trap for bots: out of sight and out of the tab order. */}
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <input type="text" name="fax" tabindex="-1" autocomplete="off" />
        </div>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 sm:col-span-2">
          <button
            type="submit"
            class="rounded-control bg-amber px-6 py-3 font-extrabold text-ink shadow-[0_4px_0_var(--color-amber-deep)] hover:brightness-105 active:translate-y-1 active:shadow-none"
          >
            {t.form.send}
          </button>
          <p class="min-w-0 flex-1 basis-64 text-sm text-ink-soft" set:html={rich(t.form.privacy, lang)} />
        </div>
      </form>
      <p class="mt-8 text-sm font-extrabold uppercase tracking-wide text-ink-soft">{t.emailLabel}</p>
      <p class="mt-1 break-all text-xl font-bold">
        <a href={`mailto:${SITE.supportEmail}`} class="text-teal underline underline-offset-4">{SITE.supportEmail}</a>
      </p>
      <p class="mt-2 text-ink-soft">{t.emailNote}</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16" aria-labelledby="app-help">
    <h2 id="app-help" class="text-4xl text-teal sm:text-5xl">{t.appTitle}</h2>
    <div class="mt-8">
      <FaqList faqs={t.faq} lang={lang} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16" aria-labelledby="book-help">
    <h2 id="book-help" class="text-4xl text-teal sm:text-5xl">{t.bookTitle}</h2>
    <div class="mt-8">
      <FaqList faqs={productFaq} lang={lang} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-10">
    <p class="text-lg text-ink-soft" set:html={rich(t.more, lang)} />
  </section>
</BaseLayout>
