---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import { breadcrumbs, faqPage } from '../lib/schema';
import { SITE } from '../config/site';
import { COPY } from '../i18n/copy';
import { plain, rich } from '../i18n/format';
import type { Lang } from '../i18n/locales';
import { path } from '../i18n/routes';

/*
 * Help for people who already have the app, and every question the site
 * answers elsewhere in one place. Only the support questions go in this
 * page's FAQPage markup: the others already mark up their own pages.
 */
const { lang } = Astro.props as { lang: Lang };
const c = COPY[lang];
const { ui, support: t } = c;
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: t.crumb, path: path('support', lang) },
];
const productFaq = [
  ...c.home.faq,
  ...c.babyPhotoBook.faq.filter((q) => !c.home.faq.some((h) => h.question === q.question)),
];
---

<BaseLayout
  lang={lang}
  page="support"
  title={t.title}
  description={plain(t.description, lang)}
  schema={[breadcrumbs(trail), faqPage(t.faq.map((f) => ({ ...f, answer: plain(f.answer, lang) })))]}
  pageType="ContactPage"
  cta="support"
>
  <Breadcrumbs items={trail} lang={lang} />

  <section class="mx-auto max-w-3xl px-5 pb-12 pt-8">
    <p class="font-extrabold uppercase tracking-wider text-teal">{t.eyebrow}</p>
    <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">{t.h1}</h1>
    <p class="mt-6 text-xl text-ink">{t.lead}</p>
    <div class="mt-8 rounded-card border-2 border-hair bg-surface p-6 sm:p-8">
      <p class="text-sm font-extrabold uppercase tracking-wide text-ink-soft">{t.emailLabel}</p>
      <p class="mt-1 break-all text-2xl font-bold">
        <a href={`mailto:${SITE.supportEmail}`} class="text-teal underline underline-offset-4">{SITE.supportEmail}</a>
      </p>
      <p class="mt-3 text-ink-soft">{t.emailNote}</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16" aria-labelledby="app-help">
    <h2 id="app-help" class="text-4xl text-teal sm:text-5xl">{t.appTitle}</h2>
    <div class="mt-8">
      <FaqList faqs={t.faq} lang={lang} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16" aria-labelledby="book-help">
    <h2 id="book-help" class="text-4xl text-teal sm:text-5xl">{t.bookTitle}</h2>
    <div class="mt-8">
      <FaqList faqs={productFaq} lang={lang} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-10">
    <p class="text-lg text-ink-soft" set:html={rich(t.more, lang)} />
  </section>
</BaseLayout>
