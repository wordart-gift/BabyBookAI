---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AppSpread from '../components/AppSpread.astro';
import PhoneShot from '../components/PhoneShot.astro';
import DownloadCta from '../components/DownloadCta.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqList from '../components/FaqList.astro';
import { APP_ID, BOOK_ID, breadcrumbs, faqPage, howTo, mobileApplication, photoBook } from '../lib/schema';
import { screens } from '../lib/photos';
import { COPY } from '../i18n/copy';
import { plain } from '../i18n/format';
import type { Lang } from '../i18n/locales';
import { path } from '../i18n/routes';

/*
 * Target: "baby's first year photo book" (390/mo, about 1,000 with the album
 * forms; the weakest first page of the map, Semrush Oct 2026) and family:
 * first year photo album, baby's first year book, monthly baby photo book.
 * The page that defines us: The Short Years and Duncan & Stone rank here.
 * Our angle against them: a weekly app is 52 small pieces of homework; this
 * is none.
 */
const { lang } = Astro.props as { lang: Lang };
const { ui, firstYear: t } = COPY[lang];
const SCREENS = screens(lang);
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: t.crumb, path: path('firstYear', lang) },
];
const items = t.months.items;
---

<BaseLayout
  lang={lang}
  page="firstYear"
  title={t.title}
  description={plain(t.description, lang)}
  schema={[
    breadcrumbs(trail),
    mobileApplication(lang),
    photoBook(lang),
    howTo(lang, 'firstYear', t.howTitle),
    faqPage(t.faq.map((f) => ({ ...f, answer: plain(f.answer, lang) }))),
  ]}
  about={[BOOK_ID, APP_ID]}
  cta="first-year-photo-book"
>
  <Breadcrumbs items={trail} lang={lang} />

  <section class="mx-auto grid max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] items-center gap-12 px-5 pb-20 pt-2 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:pt-7">
    <div>
      <p class="font-extrabold uppercase tracking-wider text-teal">{t.eyebrow}</p>
      <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">{t.h1}</h1>
      <p class="mt-6 max-w-xl text-xl text-ink">{t.lead}</p>
      <DownloadCta source="first-year-hero" lang={lang} class="mt-8" />
    </div>
    <div class="lg:mt-24"><AppSpread month={ui.spreadMonth} alt={ui.spreadAlt} eager /></div>
  </section>

  <section class="band" aria-labelledby="month-by-month">
    <div class="mx-auto max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] px-5">
      <p class="font-extrabold uppercase tracking-wider text-teal">{t.months.eyebrow}</p>
      <h2 id="month-by-month" class="mt-3 max-w-3xl text-4xl text-teal sm:text-5xl">{t.months.title}</h2>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">{t.months.body}</p>
      <ol class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
        {
          items.map((m, i) => (
            <li class:list={['rounded-control p-4', i === 0 || i === items.length - 1 ? 'bg-amber-wash' : 'bg-paper']}>
              <p class="text-xs font-extrabold uppercase tracking-wider text-teal">{m.n}</p>
              <p class="mt-1 font-bold leading-snug">{m.moment}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] px-5 py-20" aria-labelledby="unfinished">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 id="unfinished" class="text-4xl text-teal sm:text-5xl">{t.unfinished.title}</h2>
        <div class="mt-6 space-y-5 text-lg text-ink-soft">
          {t.unfinished.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <dl class="grid content-start gap-4 sm:grid-cols-3 lg:grid-cols-1">
        {
          t.unfinished.compare.map((c, i) => {
            const ours = i === t.unfinished.compare.length - 1;
            return (
              <div class:list={['rounded-card p-6', ours ? 'bg-teal text-surface' : 'bg-surface']}>
                <dt class:list={['font-bold', ours ? 'text-teal-wash' : 'text-ink-soft']}>{c.label}</dt>
                <dd class:list={['mt-1 font-display text-3xl font-bold', !ours && 'text-ink']}>{c.value}</dd>
              </div>
            );
          })
        }
      </dl>
    </div>
  </section>

  <HowItWorks lang={lang} title={t.howTitle} />

  <section class="band" aria-labelledby="birthday">
    <div class="mx-auto grid max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] items-center gap-12 px-5 md:grid-cols-2">
      <PhoneShot src={SCREENS.setup.src} alt={SCREENS.setup.alt} class="mx-auto w-[15rem]" />
      <div>
        <h2 id="birthday" class="text-4xl text-teal sm:text-5xl">{t.birthday.title}</h2>
        <p class="mt-5 text-lg text-ink-soft">{t.birthday.body}</p>
        <p class="mt-6">
          <a href={path('babyPhotoBook', lang)} class="font-extrabold text-teal underline underline-offset-4">{t.birthday.more}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-20" aria-labelledby="faq">
    <h2 id="faq" class="text-center text-4xl text-teal sm:text-5xl">{t.faqTitle}</h2>
    <div class="mt-10">
      <FaqList faqs={t.faq} lang={lang} />
    </div>
  </section>
</BaseLayout>
