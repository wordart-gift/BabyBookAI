---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stork from '../components/Stork.astro';
import Perch from '../components/Perch.astro';
import AppSpread from '../components/AppSpread.astro';
import PhoneShot from '../components/PhoneShot.astro';
import DownloadCta from '../components/DownloadCta.astro';
import FaqList from '../components/FaqList.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { APP_ID, BOOK_ID, faqPage, howTo, mobileApplication, photoBook } from '../lib/schema';
import { screens } from '../lib/photos';
import { COPY } from '../i18n/copy';
import { plain, rich } from '../i18n/format';
import type { Lang } from '../i18n/locales';
import { path } from '../i18n/routes';

/*
 * The home page is where paid traffic lands, so it is written to convert
 * first. It names the product the way buyers do ("baby memory book", in the
 * H1 only) and leaves ranking for "baby photo book" and "first year photo
 * book" to their own pages, which it links to with those words.
 */
const { lang } = Astro.props as { lang: Lang };
const { ui, home: t } = COPY[lang];
const SCREENS = screens(lang);
const faqs = t.faq.map((f) => ({ question: f.question, answer: f.answer }));
---

<BaseLayout
  lang={lang}
  page="home"
  title={t.title}
  description={plain(t.description, lang)}
  schema={[mobileApplication(lang), photoBook(lang), howTo(lang, 'home'), faqPage(faqs.map((f) => ({ ...f, answer: plain(f.answer, lang) })))]}
  about={[APP_ID, BOOK_ID]}
  cta="home"
>
  <!-- Hero -->
  <div class="relative overflow-x-clip">
    <Perch />
    <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-8 lg:grid-cols-[0.8fr_1.2fr] lg:pt-16">
      <div>
        <p class="font-extrabold uppercase tracking-wider text-teal">{t.eyebrow}</p>
        <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">{t.h1}</h1>
        <p class="mt-6 max-w-xl text-xl text-ink">{t.lead}</p>
        <DownloadCta source="home-hero" lang={lang} class="mt-8" />
      </div>
      <div class="relative sm:mt-24 lg:mt-0">
        <AppSpread month={ui.spreadMonth} alt={ui.spreadAlt} eager />
        <Stork
          size={120}
          stage={false}
          lang={lang}
          class="absolute -top-[118px] right-[8%] hidden drop-shadow-[0_2px_3px_rgb(14_42_49/0.18)] sm:block lg:hidden"
        />
      </div>
    </section>
  </div>

  <!-- The problem: the homework -->
  <section class="band" aria-labelledby="homework">
    <div class="mx-auto max-w-6xl px-5">
      <h2 id="homework" class="max-w-3xl text-4xl text-teal sm:text-5xl">{t.homework.title}</h2>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">{t.homework.body}</p>
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {
          t.homework.ways.map((way, i) => {
            const ours = i === t.homework.ways.length - 1;
            return (
              <li class:list={['rounded-card border p-7', ours ? 'border-teal bg-teal text-surface' : 'border-hair bg-paper']}>
                <p class:list={['font-display text-2xl font-bold', ours ? 'text-surface' : 'text-ink']}>{way.name}</p>
                <p
                  class:list={[
                    'mt-4 text-sm font-extrabold uppercase tracking-wide',
                    ours ? 'text-amber-wash' : 'text-ink-soft',
                  ]}
                >
                  {t.homework.yourPart}
                </p>
                <p class="mt-1 text-lg font-bold">{way.effort}</p>
                <p class:list={['mt-4', ours ? 'text-teal-wash' : 'text-ink-soft']}>{way.verdict}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <HowItWorks lang={lang} />

  <!-- The book -->
  <section class="band" aria-labelledby="book">
    <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 lg:grid-cols-[1.2fr_1fr]">
      <div class="mx-auto flex max-w-[34rem] items-center justify-center gap-5">
        <PhoneShot src={SCREENS.selection.src} alt={SCREENS.selection.alt} class="w-[46%]" />
        <PhoneShot src={SCREENS.order.src} alt={SCREENS.order.alt} class="w-[46%]" />
      </div>
      <div>
        <p class="font-extrabold uppercase tracking-wider text-teal">{t.book.eyebrow}</p>
        <h2 id="book" class="mt-3 text-4xl text-teal sm:text-5xl">{t.book.title}</h2>
        <p class="mt-5 text-lg text-ink-soft">{t.book.body}</p>
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4">
          {
            t.book.specs.map((spec) => (
              <div class="border-t border-hair pt-3">
                <dt class="text-sm font-extrabold uppercase tracking-wide text-ink-soft">{spec.label}</dt>
                <dd class="mt-1 font-bold" set:html={rich(spec.value, lang)} />
              </div>
            ))
          }
        </dl>
        <p class="mt-8">
          <a href={path('babyPhotoBook', lang)} class="font-extrabold text-teal underline underline-offset-4">{t.book.more}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Privacy -->
  <section class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="privacy">
    <div class="grid items-center gap-12 rounded-card bg-teal p-8 text-surface sm:p-12 lg:grid-cols-[auto_1fr]">
      <Stork size={150} swing={false} stage={false} lang={lang} class="mx-auto" />
      <div>
        <h2 id="privacy" class="text-4xl sm:text-5xl">{t.privacy.title}</h2>
        <p class="mt-5 max-w-2xl text-lg text-teal-wash">{t.privacy.body}</p>
      </div>
    </div>
  </section>

  <!-- First year, gift -->
  <section class="band" aria-labelledby="first-year">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 md:grid-cols-2">
      <PhoneShot src={SCREENS.setup.src} alt={SCREENS.setup.alt} class="mx-auto w-[15rem]" />
      <div>
        <h2 id="first-year" class="text-4xl text-teal sm:text-5xl">{t.birthday.title}</h2>
        <p class="mt-5 text-lg text-ink-soft">{t.birthday.body}</p>
        <p class="mt-8">
          <a href={path('firstYear', lang)} class="font-extrabold text-teal underline underline-offset-4">{t.birthday.more}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-5 py-20" aria-labelledby="faq">
    <h2 id="faq" class="text-center text-4xl text-teal sm:text-5xl">{t.faqTitle}</h2>
    <div class="mt-10">
      <FaqList faqs={faqs} lang={lang} />
    </div>
  </section>
</BaseLayout>
