---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PhoneShot from '../components/PhoneShot.astro';
import DownloadCta from '../components/DownloadCta.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqList from '../components/FaqList.astro';
import ToneSwatches from '../components/ToneSwatches.astro';
import { APP_ID, BOOK_ID, breadcrumbs, faqPage, howTo, mobileApplication, photoBook } from '../lib/schema';
import { screens } from '../lib/photos';
import { COPY } from '../i18n/copy';
import { plain, rich } from '../i18n/format';
import type { Lang } from '../i18n/locales';
import { path } from '../i18n/routes';

/*
 * Target: "baby boy photo album" (KD 0) and family: baby boy photo book,
 * baby boy first year album, personalized baby boy photo album. Same intent
 * as the girl page, its own copy. The only real photos we have are of a
 * girl, so this page shows the app's screens instead of a spread.
 */
const { lang } = Astro.props as { lang: Lang };
const { ui, boy: t } = COPY[lang];
const SCREENS = screens(lang);
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: COPY[lang].babyPhotoBook.crumb, path: path('babyPhotoBook', lang) },
  { name: t.crumb, path: path('boy', lang) },
];
---

<BaseLayout
  lang={lang}
  page="boy"
  title={t.title}
  description={plain(t.description, lang)}
  schema={[
    breadcrumbs(trail),
    mobileApplication(lang),
    photoBook(lang),
    howTo(lang, 'boy', t.howTitle),
    faqPage(t.faq.map((f) => ({ ...f, answer: plain(f.answer, lang) }))),
  ]}
  about={[BOOK_ID, APP_ID]}
  cta="baby-boy-photo-album"
>
  <Breadcrumbs items={trail} lang={lang} />

  <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pt-8 lg:grid-cols-[1.1fr_1fr] lg:pt-12">
    <div class="pb-12 lg:pb-20">
      <p class="font-extrabold uppercase tracking-wider text-teal">{t.eyebrow}</p>
      <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">{t.h1}</h1>
      <p class="mt-6 max-w-xl text-xl text-ink">{t.lead}</p>
      <DownloadCta source="baby-boy-hero" lang={lang} class="mt-8" />
    </div>
    <div class="mx-auto flex w-full max-w-[30rem] items-center justify-center gap-5 pb-12 lg:pb-20">
      <PhoneShot src={SCREENS.setup.src} alt={SCREENS.setup.alt} class="w-[48%]" eager />
      <PhoneShot src={SCREENS.selection.src} alt={SCREENS.selection.alt} class="w-[48%]" eager />
    </div>
  </section>

  <section class="band" aria-labelledby="from-thousands">
    <div class="mx-auto max-w-6xl px-5">
      <h2 id="from-thousands" class="max-w-3xl text-4xl text-teal sm:text-5xl">{t.thousands.title}</h2>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">{t.thousands.body}</p>
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {
          t.thousands.steps.map((step, i) => (
            <li class:list={['rounded-card p-7', i === 2 ? 'bg-teal text-surface' : 'bg-paper']}>
              <p class:list={['font-display text-3xl font-bold', i === 2 ? 'text-surface' : 'text-ink']}>{step.label}</p>
              <p class:list={['mt-3', i === 2 ? 'text-teal-wash' : 'text-ink-soft']}>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm text-ink-soft">{t.thousands.note}</p>
    </div>
  </section>

  <HowItWorks lang={lang} title={t.howTitle} />

  <section class="band" aria-labelledby="his-colors">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2">
      <div>
        <p class="font-extrabold uppercase tracking-wider text-teal">{t.colors.eyebrow}</p>
        <h2 id="his-colors" class="mt-3 text-4xl text-teal sm:text-5xl">{t.colors.title}</h2>
        <div class="mt-5 space-y-4 text-lg text-ink-soft">
          {t.colors.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <ToneSwatches selected="blue" lang={lang} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-20" aria-labelledby="details">
    <h2 id="details" class="text-4xl text-teal sm:text-5xl">{t.details.title}</h2>
    <p class="mt-5 text-lg text-ink-soft" set:html={rich(t.details.body, lang)} />
    <p class="mt-6 text-ink-soft" set:html={rich(t.details.more, lang)} />
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-20" aria-labelledby="faq">
    <h2 id="faq" class="text-center text-4xl text-teal sm:text-5xl">{t.faqTitle}</h2>
    <div class="mt-10">
      <FaqList faqs={t.faq} lang={lang} />
    </div>
  </section>
</BaseLayout>
