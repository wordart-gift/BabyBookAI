---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AppSpread from '../components/AppSpread.astro';
import Butterflies from '../components/Butterflies.astro';
import PhoneShot from '../components/PhoneShot.astro';
import DownloadCta from '../components/DownloadCta.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqList from '../components/FaqList.astro';
import { APP_ID, BOOK_ID, breadcrumbs, faqPage, howTo, mobileApplication, photoBook } from '../lib/schema';
import { screens, spreads } from '../lib/photos';
import { COPY } from '../i18n/copy';
import { plain, rich } from '../i18n/format';
import type { Lang } from '../i18n/locales';
import { path } from '../i18n/routes';

/*
 * Target: "baby photo album" (1,900/mo in the US, 2,400 in the UK) and "baby
 * photo book" (1,000), which share one first page (Semrush, Oct 2026,
 * docs/keywords/en): the H1 says album, the URL and the body say photo book.
 * Family: photo album for baby, baby album book, personalized / custom baby
 * photo album (a section here, not a page of its own). A full category page, the
 * bar set by PikPerfect at #3: exact keyword in the H1, the process in three
 * steps, the product inside and out, personalization, gift, real copy, FAQ.
 * In other languages, the market's product word leads (álbum, album photo,
 * Fotobuch...). Never say "layflat": the binding is glued.
 */
const { lang } = Astro.props as { lang: Lang };
const { ui, babyPhotoBook: t } = COPY[lang];
const SCREENS = screens(lang);
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: t.crumb, path: path('babyPhotoBook', lang) },
];
---

<BaseLayout
  lang={lang}
  page="babyPhotoBook"
  title={t.title}
  description={plain(t.description, lang)}
  schema={[
    breadcrumbs(trail),
    mobileApplication(lang),
    photoBook(lang),
    howTo(lang, 'babyPhotoBook', t.howTitle),
    faqPage(t.faq.map((f) => ({ ...f, answer: plain(f.answer, lang) }))),
  ]}
  about={[BOOK_ID, APP_ID]}
  cta="baby-photo-book"
>
  <Breadcrumbs items={trail} lang={lang} />

  <section class="relative mx-auto grid max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] items-center gap-12 px-5 pb-20 pt-2 lg:grid-cols-[0.8fr_1.2fr] lg:pt-7">
    <div>
      <p class="font-extrabold uppercase tracking-wider text-teal">{t.eyebrow}</p>
      <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">{t.h1}</h1>
      <p class="mt-6 max-w-xl text-xl text-ink">{t.lead}</p>
      <DownloadCta source="baby-photo-book-hero" lang={lang} class="mt-8" />
    </div>
    <div><AppSpread {...spreads(lang).fifth} eager /></div>
    <Butterflies />
    </section>

  <section class="band" aria-labelledby="minus-work">
    <div class="mx-auto max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] px-5">
      <h2 id="minus-work" class="max-w-3xl text-4xl text-teal sm:text-5xl">{t.features.title}</h2>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.features.items.map((f) => (
            <li class="rounded-card bg-paper p-7">
              <h3 class="text-2xl text-ink">{f.title}</h3>
              <p class="mt-3 text-ink-soft">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <HowItWorks lang={lang} title={t.howTitle} />

  <section class="band" aria-labelledby="inside">
    <div class="mx-auto max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] px-5">
      <p class="font-extrabold uppercase tracking-wider text-teal">{t.inside.eyebrow}</p>
      <h2 id="inside" class="mt-3 max-w-3xl text-4xl text-teal sm:text-5xl">{t.inside.title}</h2>
      <div class="mt-12 grid items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
        <div class="mx-auto flex max-w-[34rem] items-center justify-center gap-5">
          <PhoneShot src={SCREENS.setup.src} alt={SCREENS.setup.alt} class="w-[46%]" />
          <PhoneShot src={SCREENS.order.src} alt={SCREENS.order.alt} class="w-[46%]" />
        </div>
        <ol class="space-y-6">
          {
            t.inside.tour.map((item) => (
              <li class="border-l-4 border-amber pl-5">
                <h3 class="font-sans text-lg font-extrabold text-ink">{item.label}</h3>
                <p class="mt-1 text-ink-soft">{item.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] px-5 py-20" aria-labelledby="personalized">
    <p class="font-extrabold uppercase tracking-wider text-teal">{t.personal.eyebrow}</p>
    <h2 id="personalized" class="mt-3 max-w-3xl text-4xl text-teal sm:text-5xl">{t.personal.title}</h2>
    <p class="mt-5 max-w-2xl text-lg text-ink-soft">{t.personal.body}</p>
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        t.personal.items.map((p) => (
          <li class="rounded-card bg-surface p-7 shadow-[0_1px_0_var(--color-hair)]">
            <h3 class="text-2xl text-ink">{p.title}</h3>
            <p class="mt-3 text-ink-soft">{p.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-ink-soft" set:html={rich(t.personal.colors, lang)} />
  </section>

  <section class="band" aria-labelledby="specs">
    <div class="mx-auto grid max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] gap-12 px-5 lg:grid-cols-2">
      <div>
        <h2 id="specs" class="text-4xl text-teal sm:text-5xl">{t.specs.title}</h2>
        <dl class="mt-8 divide-y divide-hair border-y border-hair">
          {
            t.specs.items.map((s) => (
              <div class="grid grid-cols-[8rem_1fr] gap-4 py-4">
                <dt class="font-extrabold text-ink-soft">{s.label}</dt>
                <dd class="font-bold" set:html={rich(s.value, lang)} />
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <h2 class="text-4xl text-teal sm:text-5xl">{t.gift.title}</h2>
        <p class="mt-5 text-lg text-ink-soft">{t.gift.body}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-20" aria-labelledby="why">
    <h2 id="why" class="text-4xl text-teal sm:text-5xl">{t.why.title}</h2>
    <div class="mt-6 space-y-5 text-lg text-ink-soft">
      {t.why.paragraphs.map((p) => <p set:html={rich(p, lang)} />)}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-20" aria-labelledby="faq">
    <h2 id="faq" class="text-4xl text-teal sm:text-5xl">{t.faqTitle}</h2>
    <div class="mt-10">
      <FaqList faqs={t.faq} lang={lang} />
    </div>
  </section>
</BaseLayout>
