---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbs } from '../lib/schema';
import { COPY } from '../i18n/copy';
import { plain, rich } from '../i18n/format';
import type { Lang } from '../i18n/locales';
import { path } from '../i18n/routes';

/**
 * Terms of use and of sale, written from what the app and the order flow do
 * today (Stripe takes the card, Gelato prints, every order is confirmed by
 * hand). A draft for the same lawyer who reviews the privacy policy: the
 * points to check are the remedy for damaged or misprinted books, the
 * liability section and which law governs, which this draft leaves out.
 * The English text is the one that applies (ui.translationNote).
 */
const { lang } = Astro.props as { lang: Lang };
const { ui, terms: t } = COPY[lang];
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: t.crumb, path: path('terms', lang) },
];
const r = (s: string) => rich(s, lang);
---

<BaseLayout
  lang={lang}
  page="terms"
  title={t.title}
  description={plain(t.description, lang)}
  schema={[breadcrumbs(trail)]}
  cta="terms"
>
  <Breadcrumbs items={trail} lang={lang} />

  <article class="mx-auto max-w-3xl px-5 pb-20 pt-2 lg:pt-7">
    <p class="font-extrabold uppercase tracking-wider text-teal">{t.eyebrow}</p>
    <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">{t.h1}</h1>
    <p class="mt-4 text-ink-soft">{t.updatedLabel} {t.updated}</p>
    {ui.translationNote && <p class="mt-4 text-sm text-ink-soft" set:html={r(ui.translationNote)} />}

    <div class="mt-10 rounded-card border-2 border-hair bg-surface p-6 sm:p-10">
      <p class="text-lg" set:html={r(t.intro)} />
      {
        t.sections.map((section) => (
          <>
            <h2 class="mt-12 text-2xl text-teal">{section.title}</h2>
            {section.paragraphs?.map((p) => <p class="mt-4" set:html={r(p)} />)}
            {section.list && (
              <ul class="mt-4 list-disc space-y-2 pl-6">
                {section.list.map((item) => <li set:html={r(item)} />)}
              </ul>
            )}
          </>
        ))
      }
    </div>
  </article>
</BaseLayout>
