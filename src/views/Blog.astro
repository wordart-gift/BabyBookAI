---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { blogList, breadcrumbs } from '../lib/schema';
import { formatDate, IDEAS_PUBLISHED, postPath, postsIn } from '../lib/blog';
import { spreads } from '../lib/photos';
import { COPY } from '../i18n/copy';
import { plain } from '../i18n/format';
import type { Lang } from '../i18n/locales';
import { path } from '../i18n/routes';

/*
 * The blog's index in one language: its own posts, newest first, then the ideas
 * article, which was here before the blog and keeps its address. A list rather
 * than a grid of cards: titles do the work, and a language with two entries does
 * not look like a half-empty shelf.
 */
const { lang } = Astro.props as { lang: Lang };
const { ui, blog: t, ideas } = COPY[lang];
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: t.crumb, path: path('blog', lang) },
];
const spread = spreads(lang).seventh;
const entries = [
  ...(await postsIn(lang)).map((post) => ({
    href: postPath(post),
    title: post.data.headline,
    description: post.data.description,
    date: post.data.date,
    cover: post.data.cover,
    alt: post.data.coverAlt,
  })),
  {
    href: path('ideas', lang),
    title: ideas.headline,
    description: plain(ideas.description, lang),
    date: IDEAS_PUBLISHED,
    cover: spread.src,
    alt: spread.alt,
  },
];
---

<BaseLayout
  lang={lang}
  page="blog"
  title={t.title}
  description={t.description}
  pageType="CollectionPage"
  schema={[breadcrumbs(trail), blogList(entries.map((e) => ({ name: e.title, path: e.href })), path('blog', lang))]}
  cta="blog"
>
  <Breadcrumbs items={trail} lang={lang} />

  <section class="mx-auto max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] px-5 pb-16 pt-6 lg:pt-10">
    <h1 class="max-w-4xl text-[2.6rem] text-teal sm:text-6xl">{t.h1}</h1>
    <p class="mt-6 max-w-2xl text-xl text-ink">{t.lead}</p>

    <ul class="mt-14 space-y-14 lg:mt-20 lg:space-y-20">
      {
        entries.map((entry, i) => (
          <li>
            {/* An <article>: on a phone the site centres headings, but not inside one. */}
            <article class="group relative grid items-center gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-12">
            <Image
              src={entry.cover}
              alt={entry.alt}
              width={720}
              widths={[420, 720, 1080]}
              sizes="(min-width: 768px) 40vw, calc(100vw - 2.5rem)"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="aspect-[3/2] h-auto w-full rounded-card object-cover"
            />
            <div>
              <h2 class="text-3xl text-teal sm:text-4xl">
                {/* The link covers the whole row, picture included. */}
                <a href={entry.href} class="underline-offset-4 after:absolute after:inset-0 after:content-[''] group-hover:underline">
                  {entry.title}
                </a>
              </h2>
              <p class="mt-3 text-lg text-ink">{entry.description}</p>
              <p class="mt-3 text-sm text-ink-soft">
                <time datetime={entry.date}>{formatDate(entry.date, lang)}</time>
              </p>
            </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
