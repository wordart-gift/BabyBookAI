---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import PostBody from '../components/PostBody.astro';
import { article, breadcrumbs, faqPage } from '../lib/schema';
import { formatDate, postLang, postPath, postSlug, type Post } from '../lib/blog';
import { COPY } from '../i18n/copy';
import { plain } from '../i18n/format';
import { path } from '../i18n/routes';

/*
 * A blog post, in the frame of the ideas article (Ideas.astro). A post stands
 * alone in its language: no hreflang, and the language switcher goes to the
 * blog in the other language, since no other language has this same text.
 */
const { post } = Astro.props as { post: Post };
const lang = postLang(post);
const { ui, ideas, blog } = COPY[lang];
const { title, headline, crumb, description, lead, date, updated, faq } = post.data;
const { Content, headings } = await render(post);
const postUrl = postPath(post);
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: blog.crumb, path: path('blog', lang) },
  { name: crumb, path: postUrl },
];
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  lang={lang}
  page={null}
  switcherPage="blog"
  title={title}
  description={plain(description, lang)}
  type="article"
  schema={[
    breadcrumbs(trail),
    article({ path: postUrl, headline, description: plain(description, lang), datePublished: date, dateModified: updated, type: 'BlogPosting', lang }),
    ...(faq.length ? [faqPage(faq.map((f) => ({ ...f, answer: plain(f.answer, lang) })))] : []),
  ]}
  cta={`blog-${postSlug(post)}`}
>
  <Breadcrumbs items={trail} lang={lang} />

  <article class="mx-auto max-w-3xl px-5 pb-10 pt-6 lg:pt-10">
    <h1 class="text-[2.6rem] text-teal sm:text-6xl">{headline}</h1>
    <p class="mt-4 text-sm text-ink-soft">
      {ideas.byline} · <time datetime={updated ?? date}>{formatDate(updated ?? date, lang)}</time>
    </p>
    <p class="mt-6 text-xl text-ink">{lead}</p>

    {
      toc.length > 2 && (
        <nav aria-labelledby="toc-title" class="mt-10 rounded-card bg-surface p-6">
          <p id="toc-title" class="font-extrabold text-ink">{ideas.tocTitle}</p>
          <ol class="mt-3 list-decimal space-y-1 pl-6">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="text-teal underline underline-offset-4">{h.text}</a></li>)}
          </ol>
        </nav>
      )
    }

    <div class="post mt-12">
      <PostBody lang={lang}><Content /></PostBody>
    </div>

    <div class="mt-12 rounded-card bg-teal p-8 text-surface">
      <p class="font-display text-3xl font-bold">{ideas.box.title}</p>
      <p class="mt-3 text-teal-wash">{ideas.box.body}</p>
      <a
        href="#download"
        class="mt-6 inline-block rounded-control bg-amber px-6 py-3 font-extrabold text-ink shadow-[0_4px_0_var(--color-amber-deep)] hover:brightness-105"
        >{ui.getApp}</a
      >
    </div>
  </article>

  {
    faq.length > 0 && (
      <section class="mx-auto max-w-3xl px-5 pb-20" aria-labelledby="faq">
        <h2 id="faq" class="text-4xl text-teal sm:text-5xl">{ideas.faqTitle}</h2>
        <div class="mt-10">
          <FaqList faqs={faq} lang={lang} />
        </div>
      </section>
    )
  }
</BaseLayout>
