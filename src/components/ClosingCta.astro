---
import Stork from './Stork.astro';
import DownloadCta from './DownloadCta.astro';

/**
 * The last section of every page, and the target of the header's
 * "Get the app" (#download), so that link works wherever it is clicked.
 */
export interface Props {
  source: string;
}
---

<section id="download" class="mx-auto mt-4 max-w-6xl scroll-mt-6 px-5" aria-labelledby="download-title">
  <div class="flex flex-col items-center rounded-card bg-amber-wash px-6 py-14 text-center">
    <Stork size={110} stage={false} />
    <h2 id="download-title" class="mt-4 text-4xl text-teal sm:text-5xl">Make the book in minutes. Keep it for good.</h2>
    <p class="mt-4 max-w-xl text-lg text-ink-soft">
      Download BabyBookAI, give it your baby’s name and dates, and see their first year laid out before your
      coffee gets cold.
    </p>
    <DownloadCta source={Astro.props.source} center class="mt-8" />
  </div>
</section>
