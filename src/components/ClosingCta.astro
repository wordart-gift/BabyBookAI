---
import Stork from './Stork.astro';
import DownloadCta from './DownloadCta.astro';
import { COPY } from '../i18n/copy';
import type { Lang } from '../i18n/locales';

/**
 * The last section of every page, and the target of the header's
 * "Get the app" (#download), so that link works wherever it is clicked.
 */
export interface Props {
  source: string;
  lang: Lang;
}

const { source, lang } = Astro.props;
const ui = COPY[lang].ui;
---

<section id="download" class="mx-auto mt-4 max-w-6xl scroll-mt-6 px-5" aria-labelledby="download-title">
  <div class="flex flex-col items-center rounded-card bg-amber-wash px-6 py-14 text-center">
    <Stork size={110} stage={false} lang={lang} />
    <h2 id="download-title" class="mt-4 text-4xl text-teal sm:text-5xl">{ui.closing.title}</h2>
    <p class="mt-4 max-w-xl text-lg text-ink-soft">{ui.closing.body}</p>
    <DownloadCta source={source} lang={lang} center class="mt-8" />
  </div>
</section>
