---
/**
 * The visible trail. Its BreadcrumbList JSON-LD comes from the same items,
 * built by the page with breadcrumbs() in lib/schema.ts.
 */
import { COPY } from '../i18n/copy';
import type { Lang } from '../i18n/locales';

export interface Props {
  items: { name: string; path: string }[];
  lang: Lang;
}

const { items, lang } = Astro.props;
---

{/* 36px tall (pt-4 and one line of text-sm): the pages that show it start
    their hero 36px less low (lg:pt-7 against the home's lg:pt-16), so the
    title and the picture sit at the same height on every page. */}
<nav aria-label={COPY[lang].ui.breadcrumb} class="mx-auto max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] px-5 pt-4 text-sm font-semibold text-ink-soft">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page" class="text-ink">
              {item.name}
            </span>
          ) : (
            <a href={item.path} class="hover:text-teal">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
