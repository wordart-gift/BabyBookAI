---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import appStoreBadge from '../assets/badges/app-store.svg';
import { SMART_LINK, STORES } from '../config/site';
import { COPY } from '../i18n/copy';
import type { Lang } from '../i18n/locales';

/**
 * The stores' official badges, unaltered, as their guidelines require
 * (Apple: developer.apple.com/app-store/marketing/guidelines; Google:
 * partnermarketinghub.withgoogle.com), Google's in the page's language. Both
 * at the same height. A store with no URL in site.ts yet gets no badge
 * (Apple's rules cover only live apps): a "coming soon" label of the same
 * height stands in.
 */
export interface Props {
  class?: string;
  lang: Lang;
  /** Where on the site the click came from, for the store's campaign stats. */
  source: string;
}

const { class: className, lang, source } = Astro.props;
const b = COPY[lang].ui.badges;
const playBadges = import.meta.glob<{ default: ImageMetadata }>('../assets/badges/google-play-*.png', { eager: true });
const playBadge = playBadges[`../assets/badges/google-play-${lang}.png`].default;
// The listing in the page's language (hl); `referrer` passes through to the
// install, for campaign stats.
const playUrl = STORES.googlePlay
  ? `${STORES.googlePlay}&hl=${lang}&referrer=${encodeURIComponent(`utm_source=site&utm_medium=${source}`)}`
  : `${SMART_LINK}?src=${source}`;
---

<ul class:list={['flex flex-wrap items-center gap-3', className]} aria-label={b.aria}>
  <li>
    {
      STORES.appStore ? (
        <a href={`${STORES.appStore}?ct=${source}`} class="block">
          <Image src={appStoreBadge} alt={b.appStore} height={52} class="h-[52px] w-auto" />
        </a>
      ) : (
        <p class="flex h-[52px] flex-col justify-center rounded-control border border-hair bg-paper px-5 leading-tight text-ink-soft">
          <span class="text-xs font-semibold">{b.iphone}</span>
          <span class="font-extrabold text-ink">{b.comingSoon}</span>
        </p>
      )
    }
  </li>
  <li>
    <a href={playUrl} class="block">
      <Image src={playBadge} alt={b.googlePlay} height={52} densities={[1, 2]} class="h-[52px] w-auto" />
    </a>
  </li>
</ul>
