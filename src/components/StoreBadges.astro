---
import { Image } from 'astro:assets';
import appStoreBadge from '../assets/badges/app-store.svg';
import googlePlayBadge from '../assets/badges/google-play.png';
import { SMART_LINK, STORES } from '../config/site';

/**
 * The stores' official badges, unaltered, as their guidelines require
 * (Apple: developer.apple.com/app-store/marketing/guidelines; Google:
 * partnermarketinghub.withgoogle.com). Both at the same height. A store with
 * no URL in site.ts yet gets no badge (Apple's rules cover only live apps):
 * a "coming soon" label of the same height stands in.
 */
export interface Props {
  class?: string;
  /** Where on the site the click came from, for the store's campaign stats. */
  source: string;
}

const { class: className, source } = Astro.props;
// Google Play passes `referrer` through to the install, for campaign stats.
const playUrl = STORES.googlePlay
  ? `${STORES.googlePlay}&referrer=${encodeURIComponent(`utm_source=site&utm_medium=${source}`)}`
  : `${SMART_LINK}?src=${source}`;
---

<ul class:list={['flex flex-wrap items-center gap-3', className]} aria-label="Download BabyBookAI">
  <li>
    {
      STORES.appStore ? (
        <a href={`${STORES.appStore}?ct=${source}`} class="block">
          <Image src={appStoreBadge} alt="Download on the App Store" height={52} class="h-[52px] w-auto" />
        </a>
      ) : (
        <p class="flex h-[52px] flex-col justify-center rounded-control border border-hair bg-paper px-5 leading-tight text-ink-soft">
          <span class="text-xs font-semibold">iPhone</span>
          <span class="font-extrabold text-ink">App Store: coming soon</span>
        </p>
      )
    }
  </li>
  <li>
    <a href={playUrl} class="block">
      <Image
        src={googlePlayBadge}
        alt="Get it on Google Play"
        height={52}
        densities={[1, 2]}
        class="h-[52px] w-auto"
      />
    </a>
  </li>
</ul>
