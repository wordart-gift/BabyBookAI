---
import { Image } from 'astro:assets';
import appStoreBadge from '../assets/badges/app-store.svg';
import googlePlayBadge from '../assets/badges/google-play.png';
import { SMART_LINK, STORES } from '../config/site';

/**
 * The stores' official badges, unaltered, as their guidelines require
 * (Apple: developer.apple.com/app-store/marketing/guidelines; Google:
 * partnermarketinghub.withgoogle.com). Both at the same height. Until a
 * store URL is set in site.ts the badge points at the smart link, which
 * falls back to the download section.
 */
export interface Props {
  class?: string;
  /** Where on the site the click came from, for the store's campaign stats. */
  source: string;
}

const { class: className, source } = Astro.props;
const withSource = (url: string | null) => url ?? `${SMART_LINK}?src=${source}`;
---

<ul class:list={['flex flex-wrap items-center gap-3', className]} aria-label="Download BabyBookAI">
  <li>
    <a href={withSource(STORES.appStore)} class="block">
      <Image src={appStoreBadge} alt="Download on the App Store" height={52} class="h-[52px] w-auto" />
    </a>
  </li>
  <li>
    <a href={withSource(STORES.googlePlay)} class="block">
      <Image
        src={googlePlayBadge}
        alt="Get it on Google Play"
        height={52}
        densities={[1, 2]}
        class="h-[52px] w-auto"
      />
    </a>
  </li>
</ul>
