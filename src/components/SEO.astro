---
import { GOOGLE, SITE } from '../config/site';
import { COPY } from '../i18n/copy';
import { LANGS, LOCALES, type Lang } from '../i18n/locales';
import { alternates, path, type PageId } from '../i18n/routes';
import { graph, organization, webPage, website, type PageType, type SchemaNode } from '../lib/schema';

export interface Props {
  /**
   * The full <title>, written per page and language: [searched keyword] +
   * [what is different]. Not templated, because the keyword has to lead.
   */
  title: string;
  description: string;
  lang: Lang;
  page: PageId | null;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** The page's own nodes; WebSite, Organization and WebPage are added here. */
  schema?: SchemaNode[];
  /** schema.org type of the page itself. */
  pageType?: PageType;
  /** @ids of what the page is about (the app, the book). */
  about?: string[];
}

const {
  title,
  description,
  lang,
  page,
  image = SITE.defaultOgImage,
  imageAlt = COPY[lang].ui.ogImageAlt,
  type = 'website',
  noindex = false,
  schema = [],
  pageType,
  about,
} = Astro.props;

const canonical = new URL(page ? path(page, lang) : Astro.url.pathname, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
// The same page in every language, and English for anyone else (x-default).
const hreflang =
  page && !noindex
    ? [
        ...alternates(page).map((alt) => ({ hreflang: LOCALES[alt.lang].tag, href: new URL(alt.path, SITE.url).href })),
        { hreflang: 'x-default', href: new URL(path(page, 'en'), SITE.url).href },
      ]
    : [];
const hasBreadcrumb = schema.some((node) => node['@type'] === 'BreadcrumbList');
const nodes = noindex
  ? []
  : [
      website(lang),
      organization(lang),
      webPage({ url: canonical, name: title, description, image: imageUrl, type: pageType, hasBreadcrumb, about, lang }),
      ...schema,
    ];
---

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{hreflang.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
{GOOGLE.siteVerification && <meta name="google-site-verification" content={GOOGLE.siteVerification} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={LOCALES[lang].og} />
{
  page &&
    LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALES[l].og} />)
}
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{nodes.length > 0 && <script is:inline type="application/ld+json" set:html={graph(nodes)} />}

{
  GOOGLE.analyticsId && (
    <>
      <script is:inline type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE.analyticsId}`} />
      <script
        is:inline
        type="text/partytown"
        set:html={`window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};gtag('js',new Date());gtag('config','${GOOGLE.analyticsId}');`}
      />
    </>
  )
}
