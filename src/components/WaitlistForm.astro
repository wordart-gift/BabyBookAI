---
/**
 * A plain HTML form: it posts and gets a redirect, so it works with no JS at
 * all. The endpoint (a Cloudflare Pages Function, /api/waitlist) is built in
 * the waitlist step; `source` says which page the signup came from.
 */
export interface Props {
  source: string;
  class?: string;
  /** Unique per page when the form appears more than once. */
  id?: string;
}

const { source, class: className, id = 'waitlist-email' } = Astro.props;
---

<form action="/api/waitlist" method="post" class:list={['w-full max-w-md', className]}>
  <input type="hidden" name="source" value={source} />
  <label for={id} class="sr-only">Your email</label>
  <div class="flex flex-col gap-3 sm:flex-row">
    <input
      id={id}
      name="email"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@email.com"
      class="min-w-0 flex-1 rounded-control border-2 border-hair bg-surface px-4 py-3.5 text-lg text-ink placeholder:text-ink-soft/60 focus:border-teal-light focus:outline-none"
    />
    <button
      type="submit"
      class="rounded-control bg-amber px-6 py-3.5 text-lg font-extrabold text-ink shadow-[0_3px_0_var(--color-amber-deep)] hover:bg-amber-deep hover:text-surface active:translate-y-px active:shadow-none"
    >
      Join the waitlist
    </button>
  </div>
  <p class="mt-3 text-sm text-ink-soft">One email when the app is out. Nothing else, ever.</p>
</form>
