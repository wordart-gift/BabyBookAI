---
import { SITE } from '../config/site';

const nav = [
  { href: '/baby-photo-book/', label: 'Baby photo book' },
  { href: '/first-year-photo-book/', label: 'First year book' },
];
const current = Astro.url.pathname;
---

<header class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-5 py-4">
  <a href="/" class="font-display text-2xl font-bold text-teal" aria-label={`${SITE.name} home`}>
    {SITE.name}
  </a>
  <nav aria-label="Main" class="flex items-center gap-5">
    <ul class="hidden items-center gap-5 sm:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="font-semibold text-ink-soft hover:text-teal"
              aria-current={current === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="#download"
      class="rounded-control bg-amber px-4 py-2 font-extrabold text-ink hover:bg-amber-deep hover:text-surface"
    >
      Get the app
    </a>
  </nav>
</header>
