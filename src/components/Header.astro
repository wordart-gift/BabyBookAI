---
import { SITE } from '../config/site';
import { COPY } from '../i18n/copy';
import { LANGS, LOCALES, type Lang } from '../i18n/locales';
import { path, type PageId } from '../i18n/routes';

export interface Props {
  lang: Lang;
  page: PageId | null;
}

const { lang, page } = Astro.props;
const ui = COPY[lang].ui;
const nav = [
  { href: path('babyPhotoBook', lang), label: ui.nav.babyPhotoBook },
  { href: path('firstYear', lang), label: ui.nav.firstYear },
];
const current = Astro.url.pathname;
---

<header class="mx-auto flex w-full max-w-6xl items-center justify-between gap-3 px-5 py-4">
  <a href={path('home', lang)} class="font-display text-2xl font-bold text-teal" aria-label={ui.homeAria}>
    {SITE.name}
  </a>
  <nav aria-label={ui.mainNav} class="flex items-center gap-3 sm:gap-5">
    <ul class="hidden items-center gap-5 md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="font-bold text-ink hover:text-teal"
              aria-current={current === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    {/* The language switcher: a <details>, so it needs no JS. Each link goes
        to the same page in the other language. */}
    <details class="lang relative">
      <summary
        class="flex cursor-pointer list-none items-center gap-1.5 rounded-control px-2 py-2 font-bold text-ink hover:text-teal [&::-webkit-details-marker]:hidden"
        aria-label={ui.language}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9.5"></circle>
          <path d="M2.5 12h19M12 2.5c2.6 2.8 3.8 6 3.8 9.5s-1.2 6.7-3.8 9.5c-2.6-2.8-3.8-6-3.8-9.5s1.2-6.7 3.8-9.5Z"></path>
        </svg>
        <span class="text-sm uppercase">{lang}</span>
      </summary>
      <ul class="absolute right-0 z-30 mt-2 w-44 rounded-card border border-hair bg-surface p-2 shadow-[0_18px_40px_-12px_rgb(14_42_49/0.35)]">
        {
          LANGS.map((l) => (
            <li>
              <a
                href={path(page ?? 'home', l)}
                hreflang={LOCALES[l].tag}
                lang={LOCALES[l].tag}
                aria-current={l === lang ? 'true' : undefined}
                class:list={[
                  'block rounded-control px-3 py-2 font-bold hover:bg-teal-wash',
                  l === lang ? 'text-teal' : 'text-ink',
                ]}
              >
                {LOCALES[l].name}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <a
      href="#download"
      class="whitespace-nowrap rounded-control bg-amber px-4 py-2 font-extrabold text-ink shadow-[0_4px_0_var(--color-amber-deep)] hover:brightness-105 active:translate-y-1 active:shadow-none"
    >
      {ui.getApp}
    </a>
  </nav>
</header>
