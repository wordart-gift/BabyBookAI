---
import QRCode from 'qrcode';
import { SMART_LINK } from '../config/site';
import { COPY } from '../i18n/copy';
import type { Lang } from '../i18n/locales';

/**
 * One QR code for both stores: it opens the /get/ smart link, which sends an
 * iPhone to the App Store and an Android phone to Google Play. Drawn as SVG
 * at build time, so it costs no JS and no request. Only worth showing on a
 * computer: on a phone the badges are one tap away.
 */
export interface Props {
  source: string;
  lang: Lang;
  size?: number;
  class?: string;
}

const { source, lang, size = 132, class: className } = Astro.props;
const qr = COPY[lang].ui.qr;
const svg = await QRCode.toString(`${SMART_LINK}?src=qr-${source}`, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#0e2a31', light: '#ffffff' },
});
---

<figure class:list={['flex items-center gap-4', className]}>
  <div
    class="shrink-0 rounded-control bg-surface p-3 shadow-[0_0_0_1px_var(--color-hair)]"
    style={`width:${size}px`}
    role="img"
    aria-label={qr.aria}
    set:html={svg}
  />
  <figcaption class="w-44 text-sm font-semibold text-ink-soft">
    <span class="block font-extrabold text-ink">{qr.title}</span>
    {qr.body}
  </figcaption>
</figure>
