---
import Stork from './Stork.astro';

/**
 * The stork perched on a branch that comes in from the right edge of the page,
 * on the home hero. It sits in a band the sky knows about: Sky.astro keeps its
 * clouds out of viewport y 105-295px, so none ever passes behind the white bird
 * (in the app a white cloud behind it merged with it). Large screens only, where
 * the hero has two columns and the space above the book is empty.
 *
 * Same manner as the stork: flat fills from its palette (the brown of its legs,
 * the green of the app's success colour), no outlines, no gradients.
 * The branch is 380 x 80; the stork is 120 wide, its feet on the branch's top.
 */
---

<div class="pointer-events-none absolute right-0 top-10 z-0 hidden h-[180px] w-[380px] lg:block" aria-hidden="true">
  <svg class="absolute left-0 top-[100px]" width="380" height="80" viewBox="0 0 380 80">
    <path
      d="M380,20 C330,22 280,28 230,34 C170,42 110,52 50,68 L4,78 L6,82 C40,80 90,76 150,68 C210,60 290,50 380,44 Z"
      fill="#9a5e1c"></path>
    <path d="M380,28 C330,30 280,36 230,42 C170,50 110,60 50,72" stroke="#b5721c" stroke-width="3" stroke-linecap="round" fill="none"
    ></path>
    <g stroke="#9a5e1c" stroke-width="5" stroke-linecap="round" fill="none">
      <path d="M130,56 C120,40 112,34 96,30"></path>
      <path d="M182,57 C178,70 172,76 164,82"></path>
    </g>
    <g fill="#3f7d5a">
      <path d="M0,0 C6,-8 16,-8 22,0 C16,8 6,8 0,0 Z" transform="translate(96 30) rotate(-160)"></path>
      <path d="M0,0 C6,-8 16,-8 22,0 C16,8 6,8 0,0 Z" transform="translate(164 82) rotate(115)"></path>
      <path d="M0,0 C6,-8 16,-8 22,0 C16,8 6,8 0,0 Z" transform="translate(24 73) rotate(-35)"></path>
    </g>
    <g fill="#7db394">
      <path d="M0,0 C6,-8 16,-8 22,0 C16,8 6,8 0,0 Z" transform="translate(100 33) rotate(-105)"></path>
      <path d="M0,0 C6,-8 16,-8 22,0 C16,8 6,8 0,0 Z" transform="translate(110 38) rotate(-60)"></path>
      <path d="M0,0 C6,-8 16,-8 22,0 C16,8 6,8 0,0 Z" transform="translate(170 76) rotate(150)"></path>
    </g>
  </svg>
  <Stork size={120} stage={false} class="absolute left-[226px] top-1" />
</div>
