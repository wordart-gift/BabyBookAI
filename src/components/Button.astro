---
import type { HTMLAttributes } from 'astro/types';

/**
 * Amber means "the next step" and nothing else, as in the app: one primary
 * button per screenful. Everything else is the quiet variant. The solid edge
 * under the face is the app's chunky button: pressing sinks the face onto it.
 */
type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  variant?: 'primary' | 'quiet';
  href?: string;
};

const { variant = 'primary', href, class: className, ...rest } = Astro.props;
const classes = [
  'inline-flex items-center justify-center gap-2 rounded-control px-6 py-3.5 text-lg font-extrabold transition-colors',
  variant === 'primary'
    ? 'bg-amber text-ink shadow-[0_4px_0_var(--color-amber-deep)] hover:brightness-105 active:translate-y-1 active:shadow-none'
    : 'border-2 border-hair bg-surface text-ink shadow-[0_4px_0_var(--color-hair)] active:translate-y-1 active:shadow-none',
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
