---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A month spread drawn the way the printed book draws it (librofotos
 * design/catalog.py, the "seven-anchor" template): cream paper, the month in
 * spaced capitals, the dates in italic Lora, one large photograph on the left
 * and a grid of six on the right, nothing across the fold.
 *
 * Built in HTML rather than shipped as a picture so it stays sharp at every
 * size and weighs nothing. Photos are optional: without one, a slot shows
 * the soft tone the design renders use, until real photographs are in.
 */
export interface Props {
  month: string;
  dates: string;
  photos?: { src: ImageMetadata; alt: string }[];
  class?: string;
  /** The first spread on the page is the LCP candidate: load it eagerly. */
  eager?: boolean;
}

const { month, dates, photos = [], class: className, eager = false } = Astro.props;
const tones = ['#a9b0bb', '#b2b8ae', '#bdaaae', '#cbbfa8', '#aeb5ab', '#c9bea7', '#c4b7a2'];
const slots = Array.from({ length: 7 }, (_, i) => ({ photo: photos[i], tone: tones[i] }));
const [hero, ...grid] = slots;
---

<figure class:list={['book', className]}>
  <div class="book-spread">
    <div class="book-page book-left">
      <p class="book-month">{month}</p>
      <p class="book-dates">{dates}</p>
      <div class="book-hero">
        {
          hero.photo ? (
            <Image
              src={hero.photo.src}
              alt={hero.photo.alt}
              widths={[240, 400, 640]}
              sizes="(min-width: 1024px) 300px, 30vw"
              loading={eager ? 'eager' : 'lazy'}
              fetchpriority={eager ? 'high' : 'auto'}
            />
          ) : (
            <span class="book-slot" style={`--tone:${hero.tone}`} />
          )
        }
      </div>
    </div>
    <div class="book-page book-right">
      {
        grid.map((slot) =>
          slot.photo ? (
            <Image
              src={slot.photo.src}
              alt={slot.photo.alt}
              widths={[160, 240, 360]}
              sizes="(min-width: 1024px) 160px, 16vw"
              loading={eager ? 'eager' : 'lazy'}
            />
          ) : (
            <span class="book-slot" style={`--tone:${slot.tone}`} />
          ),
        )
      }
    </div>
  </div>
  <slot />
</figure>

<style>
  .book {
    margin: 0;
  }
  .book-spread {
    display: grid;
    grid-template-columns: 1fr 1fr;
    aspect-ratio: 2 / 1;
    background: #fbf8f3;
    border-radius: 6px;
    box-shadow:
      0 1px 2px rgb(14 42 49 / 0.08),
      0 18px 40px -12px rgb(14 42 49 / 0.28);
    position: relative;
    overflow: hidden;
    font-family: 'Lora Variable', Georgia, serif;
  }
  /* The fold: a soft shadow both ways, as the renders draw it. */
  .book-spread::after {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 4%) 0 calc(50% - 4%);
    background: linear-gradient(
      90deg,
      transparent,
      rgb(120 96 70 / 0.1) 42%,
      rgb(120 96 70 / 0.18) 50%,
      rgb(120 96 70 / 0.1) 58%,
      transparent
    );
    pointer-events: none;
  }
  .book-page {
    position: relative;
    padding: 6.5% 6% 6.5% 7%;
  }
  .book-left {
    display: grid;
    grid-template-columns: 30% 1fr;
    grid-template-rows: auto auto 1fr;
    column-gap: 4%;
  }
  .book-month {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(7px, 1.5cqi, 13px);
    letter-spacing: 0.32em;
    color: #b5721c;
    text-transform: uppercase;
  }
  .book-dates {
    grid-column: 1;
    margin: 0.3em 0 0;
    font-style: italic;
    font-size: clamp(8px, 1.8cqi, 16px);
    color: #7a6f63;
  }
  .book-hero {
    grid-column: 2;
    grid-row: 1 / span 3;
    display: flex;
  }
  .book-right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(3, 1fr);
    gap: 3%;
  }
  .book-slot,
  .book-page :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
  }
  .book-slot {
    background: linear-gradient(
      170deg,
      color-mix(in srgb, var(--tone) 70%, white),
      var(--tone) 55%,
      color-mix(in srgb, var(--tone) 80%, #3d362f)
    );
  }
  .book {
    container-type: inline-size;
  }
</style>
