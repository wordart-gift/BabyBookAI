---
import StoreBadges from './StoreBadges.astro';
import QrCode from './QrCode.astro';
import { COPY } from '../i18n/copy';
import type { Lang } from '../i18n/locales';

/**
 * Badges everywhere, side by side. The QR code only in the closing download
 * section, beside the badges and from md up, where the visitor is on a
 * computer: in a hero column it stacked under the badges and made the hero
 * too tall (Carlos, Oct 2026), and the stores' own pages and the competitors'
 * keep their heroes to the two badges. The header's "Get the app" leads to it.
 */
export interface Props {
  source: string;
  lang: Lang;
  class?: string;
  /** Centre the block (the closing call to action) instead of left-aligning it. */
  center?: boolean;
}

const { source, lang, class: className, center = false } = Astro.props;
---

<div
  data-cta
  class:list={[
    'flex flex-col gap-6',
    center && 'items-center md:flex-row md:justify-center md:gap-10',
    className,
  ]}
>
  <div class:list={['flex flex-col gap-3', center && 'items-center']}>
    <StoreBadges source={source} lang={lang} class={center ? 'justify-center' : undefined} />
    <p class="text-sm text-ink-soft">{COPY[lang].ui.free}</p>
  </div>
  {center && <QrCode source={source} lang={lang} class="hidden md:flex" />}
</div>
