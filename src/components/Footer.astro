---
import { Image } from 'astro:assets';
import publisherLogo from '../assets/brand/photo-to-text.png';
import { PUBLISHER, SITE, SOCIAL } from '../config/site';
import { COPY } from '../i18n/copy';
import { LANGS, LOCALES, type Lang } from '../i18n/locales';
import { path, type PageId } from '../i18n/routes';

export interface Props {
  lang: Lang;
  page: PageId | null;
}

const { lang, page } = Astro.props;
const f = COPY[lang].ui.footer;
const link = (id: keyof typeof f.links) => ({ href: path(id, lang), label: f.links[id] });
const groups = [
  { title: f.book, links: [link('babyPhotoBook'), link('firstYear'), link('boy'), link('girl'), link('ideas')] },
  { title: f.company, links: [link('about'), link('support'), link('privacy'), link('terms')] },
];
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-hair bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:grid-cols-3">
    <div>
      <p class="font-display text-xl font-bold text-teal">{SITE.name}</p>
      <p class="mt-2 text-sm text-ink-soft">{f.tagline}</p>
      <p class="mt-5 flex items-center gap-2 text-sm text-ink-soft">
        {f.productOf}
        <Image src={publisherLogo} alt={PUBLISHER.name} width={120} densities={[1, 2]} class="h-auto w-[120px]" />
      </p>
      {/* The glyphs are drawn inline: no request, no script. */}
      <p class="mt-5 text-sm font-extrabold uppercase tracking-wide text-ink-soft">{f.follow}</p>
      <ul class="mt-2 flex gap-3">
        <li>
          <a href={SOCIAL.instagram} rel="me noopener" aria-label="Instagram" class="grid size-10 place-items-center rounded-full bg-teal-wash text-teal hover:bg-teal hover:text-surface">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
        </li>
        <li>
          <a href={SOCIAL.youtube} rel="me noopener" aria-label="YouTube" class="grid size-10 place-items-center rounded-full bg-teal-wash text-teal hover:bg-teal hover:text-surface">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z"></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>
    {
      groups.map((group) => (
        <nav aria-label={group.title}>
          <p class="text-sm font-extrabold uppercase tracking-wide text-ink-soft">{group.title}</p>
          <ul class="mt-3 space-y-2">
            {group.links.map((item) => (
              <li>
                <a href={item.href} class="hover:text-teal">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  {/* Every language, in its own name: crawlers reach each one from any page. */}
  <ul class="mx-auto flex max-w-6xl flex-wrap justify-center gap-x-4 gap-y-1 border-t border-hair px-5 py-4 text-sm font-semibold text-ink-soft">
    {
      LANGS.map((l) => (
        <li>
          <a
            href={path(page ?? 'home', l)}
            hreflang={LOCALES[l].tag}
            lang={LOCALES[l].tag}
            class:list={['hover:text-teal', l === lang && 'text-teal']}
          >
            {LOCALES[l].name}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="border-t border-hair px-5 py-5 text-center text-sm text-ink-soft">
    © {year} {PUBLISHER.name}. {f.rights}
  </p>
</footer>
