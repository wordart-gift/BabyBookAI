---
/**
 * Two butterflies, as the app's sky draws them (librofotos lib/widgets/sky.dart,
 * _paintButterflies): an orange one and a blue one, each on a slow figure of
 * eight of its own, the wings folding by narrowing. In the stretch under the
 * hero, between the download buttons and the first card (Carlos, Oct 2026).
 *
 * Inline SVG and CSS only: no request, no script, and nothing they do moves
 * the page (transforms and offset-path only, out of the flow, aria-hidden).
 * Still for anyone who asks for reduced motion.
 */
export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const wings = [
  { upper: '#f2a65a', lower: '#d9823b', size: 36, left: '30%', lap: 14, delay: 0 },
  { upper: '#8fc3d6', lower: '#5e9fb5', size: 30, left: '64%', lap: 17, delay: -6 },
];
---

<div class:list={['butterflies pointer-events-none absolute inset-x-0 bottom-0 h-24', className]} aria-hidden="true">
  {
    wings.map((w, i) => (
      <div
        class="butterfly-path"
        style={`left:${w.left};--lap:${w.lap}s;--delay:${w.delay}s;--tilt-delay:${i * -1.3}s`}
      >
        <svg class="butterfly" width={w.size} height={w.size} viewBox="-12 -12 24 24">
          <g class="butterfly-wings" style={`animation-delay:${i * -0.11}s`}>
            <ellipse cx="-6.2" cy="-3.5" rx="6" ry="6.5" fill={w.upper} fill-opacity="0.9" />
            <ellipse cx="6.2" cy="-3.5" rx="6" ry="6.5" fill={w.upper} fill-opacity="0.9" />
            <ellipse cx="-4.8" cy="5" rx="4.25" ry="4.5" fill={w.lower} fill-opacity="0.9" />
            <ellipse cx="4.8" cy="5" rx="4.25" ry="4.5" fill={w.lower} fill-opacity="0.9" />
          </g>
          <rect x="-1.1" y="-8" width="2.2" height="16" rx="1.1" fill="#3f6e7a" />
        </svg>
      </div>
    ))
  }
</div>

<style>
  /* Each flies a figure of eight about 260 x 50px around its own spot. */
  .butterfly-path {
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    offset-path: path('M0,0 C40,-28 130,-28 130,0 C130,28 40,28 0,0 C-40,-28 -130,-28 -130,0 C-130,28 -40,28 0,0 Z');
    offset-rotate: 0deg;
    animation: butterfly-fly var(--lap) linear infinite;
    animation-delay: var(--delay);
  }
  .butterfly {
    display: block;
    translate: -50% -50%;
    animation: butterfly-tilt 7s ease-in-out infinite alternate;
    animation-delay: var(--tilt-delay);
  }
  .butterfly-wings {
    transform-box: view-box;
    transform-origin: 12px 12px;
    animation: butterfly-flap 0.29s ease-in-out infinite alternate;
  }
  @keyframes butterfly-fly {
    to {
      offset-distance: 100%;
    }
  }
  @keyframes butterfly-flap {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0.45);
    }
  }
  @keyframes butterfly-tilt {
    from {
      rotate: -14deg;
    }
    to {
      rotate: 14deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .butterfly-path,
    .butterfly,
    .butterfly-wings {
      animation: none;
    }
  }
</style>
