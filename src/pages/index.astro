---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stork from '../components/Stork.astro';
import Perch from '../components/Perch.astro';
import BookSpread from '../components/BookSpread.astro';
import PhoneShot from '../components/PhoneShot.astro';
import DownloadCta from '../components/DownloadCta.astro';
import FaqList from '../components/FaqList.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { APP_ID, BOOK_ID, faqPage, mobileApplication, photoBook } from '../lib/schema';
import { HOME_FAQ } from '../data/faq';
import { MONTH_SIX, SCREENS } from '../lib/photos';
import { BOOK } from '../config/site';

/*
 * The home page is where paid traffic lands, so it is written to convert
 * first. It names the product the way buyers do ("baby memory book", in the
 * H1 only) and leaves ranking for "baby photo book" and "first year photo
 * book" to their own pages, which it links to with those words.
 */

const ways = [
  {
    name: 'A fill-in memory book',
    effort: 'Print, cut, glue and write, every month',
    verdict: 'Most stop around month three.',
  },
  {
    name: 'A weekly baby book app',
    effort: 'A few minutes every week, for 52 weeks',
    verdict: 'The work is still there, in 52 pieces.',
  },
  {
    name: 'BabyBookAI',
    effort: 'Nothing until the year is over',
    verdict: 'Then one look-through, and it’s done.',
    ours: true,
  },
];

const specs = [
  { label: 'Size', value: `${BOOK.sizeIn} square` },
  { label: 'Cover', value: 'Hardcover, matte' },
  { label: 'Pages', value: `${BOOK.pagesMin}–${BOOK.pagesMax}` },
  { label: 'Paper', value: '170 gsm silk' },
  { label: 'Layout', value: 'A spread for every month' },
  { label: 'Ships', value: 'Printed in the US' },
];
---

<BaseLayout
  title="BabyBookAI — The Baby Memory Book That Makes Itself"
  description="Your baby's first year as a printed hardcover photo book, made from the photos already on your phone. BabyBookAI picks, sorts and lays them out for you."
  schema={[mobileApplication(), photoBook(), faqPage(HOME_FAQ)]}
  about={[APP_ID, BOOK_ID]}
  cta="home"
>
  <!-- Hero -->
  <div class="relative overflow-x-clip">
  <Perch />
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-8 lg:grid-cols-[1.05fr_1fr] lg:pt-16">
    <div>
      <p class="font-extrabold uppercase tracking-wider text-teal">Baby’s first year photo book</p>
      <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">The baby memory book that makes itself</h1>
      <p class="mt-6 max-w-xl text-xl text-ink">
        It reads your camera roll, picks the best photos of every month and lays out a hardcover book. You flip
        through, swap what you don’t love, and it’s on its way.
      </p>
      <DownloadCta source="home-hero" class="mt-8" />
    </div>
    <div class="relative sm:mt-24 lg:mt-0">
      <BookSpread month="Sixth month" dates="Oct 9 – Nov 8" photos={MONTH_SIX} eager />
      <Stork size={120} stage={false} class="absolute -top-[118px] right-[8%] hidden drop-shadow-[0_2px_3px_rgb(14_42_49/0.18)] sm:block lg:hidden" />
    </div>
  </section>
  </div>

  <!-- The problem: the homework -->
  <section class="band" aria-labelledby="homework">
    <div class="mx-auto max-w-6xl px-5">
      <h2 id="homework" class="max-w-3xl text-4xl text-teal sm:text-5xl">
        Every baby book is homework. Except this one.
      </h2>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">
        You already took the photos: hundreds of them, every month. Turning them into a book is the part nobody
        has time for with a baby in the house.
      </p>
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {
          ways.map((way) => (
            <li
              class:list={[
                'rounded-card border p-7',
                way.ours ? 'border-teal bg-teal text-surface' : 'border-hair bg-paper',
              ]}
            >
              <p class:list={['font-display text-2xl font-bold', way.ours ? 'text-surface' : 'text-ink']}>
                {way.name}
              </p>
              <p class:list={['mt-4 text-sm font-extrabold uppercase tracking-wide', way.ours ? 'text-amber-wash' : 'text-ink-soft']}>
                Your part
              </p>
              <p class="mt-1 text-lg font-bold">{way.effort}</p>
              <p class:list={['mt-4', way.ours ? 'text-teal-wash' : 'text-ink-soft']}>{way.verdict}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <HowItWorks />

  <!-- The book -->
  <section class="band" aria-labelledby="book">
    <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 lg:grid-cols-[1.2fr_1fr]">
      <div class="mx-auto flex max-w-[34rem] items-center justify-center gap-5">
        <PhoneShot src={SCREENS.selection.src} alt={SCREENS.selection.alt} class="w-[46%]" />
        <PhoneShot src={SCREENS.order.src} alt={SCREENS.order.alt} class="w-[46%]" />
      </div>
      <div>
        <p class="font-extrabold uppercase tracking-wider text-teal">The book</p>
        <h2 id="book" class="mt-3 text-4xl text-teal sm:text-5xl">A real hardcover, made to be kept</h2>
        <p class="mt-5 text-lg text-ink-soft">
          Your baby’s name and best photo on the cover. The day they were born on the first page. Then a
          two-page spread for every month, in the order it happened, each laid out for the photos it holds,
          until the first birthday.
        </p>
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4">
          {
            specs.map((spec) => (
              <div class="border-t border-hair pt-3">
                <dt class="text-sm font-extrabold uppercase tracking-wide text-ink-soft">{spec.label}</dt>
                <dd class="mt-1 font-bold">{spec.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-8">
          <a href="/baby-photo-book/" class="font-extrabold text-teal underline underline-offset-4">
            See the baby photo book in detail
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Privacy -->
  <section class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="privacy">
    <div class="grid items-center gap-12 rounded-card bg-teal p-8 text-surface sm:p-12 lg:grid-cols-[auto_1fr]">
      <Stork size={150} swing={false} stage={false} class="mx-auto" />
      <div>
        <h2 id="privacy" class="text-4xl sm:text-5xl">Your baby’s photos stay on your phone</h2>
        <p class="mt-5 max-w-2xl text-lg text-teal-wash">
          BabyBookAI chooses the photos on your phone, not on a server. Nothing is uploaded while it reads your
          camera roll or while you look through the book. Only when you order are the finished pages sent to the
          printer. No subscription, and no rights over your child’s pictures.
        </p>
      </div>
    </div>
  </section>

  <!-- First year, gift -->
  <section class="band" aria-labelledby="first-year">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 md:grid-cols-2">
      <PhoneShot src={SCREENS.setup.src} alt={SCREENS.setup.alt} class="mx-auto w-[15rem]" />
      <div>
        <h2 id="first-year" class="text-4xl text-teal sm:text-5xl">Ready for the first birthday</h2>
        <p class="mt-5 text-lg text-ink-soft">
          The year ends, the book is made. Order it the week of the party, or make one for the grandparents
          too. Their favorite gift is the one with the baby in it.
        </p>
        <p class="mt-8">
          <a href="/first-year-photo-book/" class="font-extrabold text-teal underline underline-offset-4">
            How the first year photo book works
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-5 py-20" aria-labelledby="faq">
    <h2 id="faq" class="text-center text-4xl text-teal sm:text-5xl">Questions parents ask</h2>
    <div class="mt-10">
      <FaqList faqs={HOME_FAQ} />
    </div>
  </section>

</BaseLayout>
