---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stork from '../components/Stork.astro';
import BookSpread from '../components/BookSpread.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { mobileApplication, organization, website } from '../lib/schema';

// Step 2 draft: the hero, to judge the visual system. The full page (and its
// final copy) is step 3.
---

<BaseLayout
  title="BabyBookAI — The Baby Memory Book That Makes Itself"
  description="Your baby's first year as a printed hardcover photo book, made from the photos already on your phone. BabyBookAI picks, sorts and lays them out for you."
  schema={[organization(), website(), mobileApplication()]}
>
  <section id="waitlist" class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-8 lg:grid-cols-[1.05fr_1fr] lg:pt-16">
    <div>
      <p class="font-extrabold uppercase tracking-wider text-teal-light">Baby’s first year photo book</p>
      <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">The baby memory book that makes itself</h1>
      <p class="mt-6 max-w-xl text-xl text-ink-soft">
        It reads your camera roll, picks the best photos of every month and lays out a hardcover book. You flip through,
        swap what you don’t love, and it’s on its way.
      </p>
      <WaitlistForm source="home-hero" class="mt-8" />
      <StoreBadges class="mt-6" />
    </div>
    <div class="relative sm:mt-24 lg:mt-0">
      <BookSpread month="02 Months" dates="1 – 28 February" eager />
      <Stork size={120} stage={false} class="absolute -top-[118px] right-[8%] hidden sm:block" />
    </div>
  </section>
</BaseLayout>
