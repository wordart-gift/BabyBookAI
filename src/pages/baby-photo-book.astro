---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BookSpread from '../components/BookSpread.astro';
import PhoneShot from '../components/PhoneShot.astro';
import DownloadCta from '../components/DownloadCta.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqList from '../components/FaqList.astro';
import { breadcrumbs, faqPage, mobileApplication } from '../lib/schema';
import { PHOTO_BOOK_FAQ } from '../data/faq';
import { NOA_SPREAD, SCREENS } from '../lib/photos';
import { BOOK } from '../config/site';

/*
 * Target: "baby photo book" (1,500/mo) and its family: baby photo album,
 * photo album for baby, baby album book, personalized / custom baby photo
 * album (a section here, not a page of its own). A full category page, the
 * bar set by PikPerfect at #3: exact keyword in the H1, the process in three
 * steps, the product inside and out, personalization, gift, real copy, FAQ.
 * Never say "layflat": the binding is glued.
 */

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Baby photo book', path: '/baby-photo-book/' },
];

const features = [
  {
    title: 'It picks the photos',
    body: 'From hundreds of shots a month, it keeps the sharpest of every moment and leaves out the blurry ones, the bursts and the duplicates.',
  },
  {
    title: 'It sorts them by month',
    body: 'Every photo goes where it belongs, by the date it was taken, so the book tells the year in the order it happened.',
  },
  {
    title: 'It lays out every page',
    body: 'Each spread is designed for the photos it holds: one hero shot and a grid, a full page, or a photo across both pages.',
  },
  {
    title: 'It prints them sharp',
    body: 'A photo only goes where it has the pixels to print well. A small copy from a chat gets a small spot, never the cover.',
  },
];

const tour = [
  { label: 'The cover', body: 'Your baby’s name and the best photo of the year, chosen from the ones you loved and shared most.' },
  { label: 'Page one', body: 'The day they were born, with a little pen drawing of a stork carrying a bundle.' },
  {
    label: 'A spread a month',
    body: 'Each month in its season: soft accents and the lightest patterns, little birds, stars or clouds, never louder than the photos.',
  },
  { label: 'The last page', body: 'A first birthday cake to close the year: and then they were one.' },
];

const personal = [
  { title: 'Their name on the cover', body: 'And the dates you choose: from the day they were born, or any day you like, for 6, 12 or 18 months.' },
  { title: 'Three paper tones', body: 'Classic cream, a soft pink or a soft blue. The whole page takes the tone, not just the trim.' },
  { title: 'Words you can rewrite', body: 'Every page comes with short lines like “Dream big, little one”. Keep them, change them, or add your own note anywhere.' },
];

const specs = [
  { label: 'Format', value: 'Square hardcover photo book' },
  { label: 'Size', value: `${BOOK.sizeIn} (${BOOK.sizeCm})` },
  { label: 'Pages', value: `${BOOK.pagesMin}–${BOOK.pagesMax}, a spread for every month` },
  { label: 'Paper', value: `${BOOK.paper}, printed in full color` },
  { label: 'Cover', value: 'Hard cover with matte lamination' },
  { label: 'Printing', value: 'Printed on demand and shipped in the US' },
];
---

<BaseLayout
  title="Baby Photo Book Made From Your Camera Roll | BabyBookAI"
  description="A hardcover baby photo book made for you: BabyBookAI picks the best photos on your phone, sorts them by month and lays out every page. 11×11 in, 30–40 pages."
  schema={[breadcrumbs(trail), mobileApplication(), faqPage(PHOTO_BOOK_FAQ)]}
  cta="baby-photo-book"
>
  <Breadcrumbs items={trail} />

  <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-8 lg:grid-cols-[1fr_1.05fr] lg:pt-12">
    <div>
      <p class="font-extrabold uppercase tracking-wider text-teal">Baby photo book</p>
      <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">Baby photo book, made from your camera roll</h1>
      <p class="mt-6 max-w-xl text-xl text-ink">
        BabyBookAI finds the best photos of your baby on your phone, sorts them month by month and lays out a
        square hardcover book. No uploading, no dragging photos into templates. You just look through it.
      </p>
      <DownloadCta source="baby-photo-book-hero" class="mt-8" />
    </div>
    <BookSpread month="05 Months" dates="Sep 9 – Oct 8" photos={NOA_SPREAD} eager />
  </section>

  <section class="band" aria-labelledby="minus-work">
    <div class="mx-auto max-w-6xl px-5">
      <h2 id="minus-work" class="max-w-3xl text-4xl text-teal sm:text-5xl">
        Everything a baby photo album should be. Minus the work.
      </h2>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          features.map((f) => (
            <li class="rounded-card bg-paper p-7">
              <h3 class="text-2xl text-ink">{f.title}</h3>
              <p class="mt-3 text-ink-soft">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <HowItWorks title="How to make a baby photo book in three steps" />

  <section class="band" aria-labelledby="inside">
    <div class="mx-auto max-w-6xl px-5">
      <p class="font-extrabold uppercase tracking-wider text-teal">Inside the book</p>
      <h2 id="inside" class="mt-3 max-w-3xl text-4xl text-teal sm:text-5xl">From the day they were born to the first birthday</h2>
      <div class="mt-12 grid items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
        <div class="mx-auto flex max-w-[34rem] items-end justify-center gap-5 self-end">
        <PhoneShot src={SCREENS.setup.src} alt={SCREENS.setup.alt} class="w-[46%]" />
        <PhoneShot src={SCREENS.order.src} alt={SCREENS.order.alt} class="w-[46%]" />
      </div>
        <ol class="space-y-6">
          {
            tour.map((t) => (
              <li class="border-l-4 border-amber pl-5">
                <h3 class="font-sans text-lg font-extrabold text-ink">{t.label}</h3>
                <p class="mt-1 text-ink-soft">{t.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="personalized">
    <p class="font-extrabold uppercase tracking-wider text-teal">Personalized</p>
    <h2 id="personalized" class="mt-3 max-w-3xl text-4xl text-teal sm:text-5xl">
      A personalized baby photo album, without the fiddly part
    </h2>
    <p class="mt-5 max-w-2xl text-lg text-ink-soft">
      A custom baby photo book usually means an evening in an editor. Here the photos are already in place, so
      making it yours is a few taps.
    </p>
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        personal.map((p) => (
          <li class="rounded-card bg-surface p-7 shadow-[0_1px_0_var(--color-hair)]">
            <h3 class="text-2xl text-ink">{p.title}</h3>
            <p class="mt-3 text-ink-soft">{p.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-ink-soft">
      Looking for colors? See the <a href="/baby-girl-photo-album/" class="font-bold text-teal underline underline-offset-4">baby girl photo album</a>{' '}
      and the <a href="/baby-boy-photo-album/" class="font-bold text-teal underline underline-offset-4">baby boy photo album</a>.
    </p>
  </section>

  <section class="band" aria-labelledby="specs">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-2">
      <div>
        <h2 id="specs" class="text-4xl text-teal sm:text-5xl">The book, in detail</h2>
        <dl class="mt-8 divide-y divide-hair border-y border-hair">
          {
            specs.map((s) => (
              <div class="grid grid-cols-[8rem_1fr] gap-4 py-4">
                <dt class="font-extrabold text-ink-soft">{s.label}</dt>
                <dd class="font-bold">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <h2 class="text-4xl text-teal sm:text-5xl">The gift grandparents ask for</h2>
        <p class="mt-5 text-lg text-ink-soft">
          A phone full of photos is hard to pass around the table. A baby photo book isn’t. It’s the gift for a
          first birthday, for Mother’s Day or Father’s Day, and the one grandparents keep on the coffee table.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-20" aria-labelledby="why">
    <h2 id="why" class="text-4xl text-teal sm:text-5xl">Why a baby photo book, when the photos are already on your phone</h2>
    <div class="mt-6 space-y-5 text-lg text-ink-soft">
      <p>
        In a baby’s first year, parents take hundreds of photos a month. They live in a camera roll, between screenshots and receipts, and they scroll past in a blur. A photo album for a baby is
        the opposite: a few of the best, in order, on paper, in a book anyone can pick up.
      </p>
      <p>
        The hard part has never been the printing. It’s the hours of choosing: which of the forty bath-time shots,
        which month that photo belongs to, how to fit an upright photo next to a wide one. That’s where most baby
        albums stall, somewhere around month three.
      </p>
      <p>
        BabyBookAI does that part for you, on your phone. It reads the dates, keeps the sharpest photo of every
        moment, gives each month its own spread and lays out a baby album book that looks designed, not dumped.
        What’s left for you is the nice part: looking through it. If you want the whole first year, from the
        hospital to the cake, see the <a href="/first-year-photo-book/" class="font-bold text-teal underline underline-offset-4">baby’s first year photo book</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-20" aria-labelledby="faq">
    <h2 id="faq" class="text-center text-4xl text-teal sm:text-5xl">Baby photo book questions</h2>
    <div class="mt-10">
      <FaqList faqs={PHOTO_BOOK_FAQ} />
    </div>
  </section>
</BaseLayout>
