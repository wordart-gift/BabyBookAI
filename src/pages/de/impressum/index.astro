---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { breadcrumbs } from '../../../lib/schema';
import { COPY } from '../../../i18n/copy';
import { path } from '../../../i18n/routes';
import { LEGAL_ENTITY, SITE } from '../../../config/site';

/**
 * Impressum (§ 5 DDG), German only (Carlos, 6 Nov 2026): the shop ships to Germany, and a German-language
 * site that sells there needs the provider's details one click from every page (the footer links it).
 * The details are the ones petsinwords.com publishes in its own Impressum. There is no copy in the other
 * languages: the duty is for Germany, Austria and Switzerland, which read German. Not in the route table
 * (src/i18n/routes.ts), so it has no hreflang twins.
 */
const lang = 'de' as const;
const ui = COPY[lang].ui;
const trail = [
  { name: ui.home, path: path('home', lang) },
  { name: 'Impressum', path: '/de/impressum/' },
];
const support = path('support', lang);
---

<BaseLayout
  lang={lang}
  page={null}
  switcherPage="about"
  title="Impressum | BabyBookAI"
  description="Impressum von BabyBookAI: Anbieter, Vertretungsberechtigter, Registernummer und Kontakt nach § 5 DDG."
  schema={[breadcrumbs(trail)]}
  cta={false}
>
  <Breadcrumbs items={trail} lang={lang} />

  <article class="mx-auto max-w-3xl px-5 pb-20 pt-2 lg:pt-7">
    <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">Impressum</h1>
    <p class="mt-4 text-ink-soft">Angaben gemäß § 5 DDG</p>

    <div class="mt-10 rounded-card border-2 border-hair bg-surface p-6 sm:p-10">
      <h2 class="text-2xl text-teal">Anbieter</h2>
      <p class="mt-4">
        {LEGAL_ENTITY.name}<br />
        {LEGAL_ENTITY.address}
      </p>

      <h2 class="mt-12 text-2xl text-teal">Vertreten durch</h2>
      <p class="mt-4">{LEGAL_ENTITY.representative}</p>

      <h2 class="mt-12 text-2xl text-teal">Registereintrag</h2>
      <p class="mt-4">Registernummer (Delaware, USA): {LEGAL_ENTITY.fileNumber}</p>

      <h2 class="mt-12 text-2xl text-teal">Steuernummer</h2>
      <p class="mt-4">Steuernummer (EIN, USA): {LEGAL_ENTITY.taxId}</p>

      <h2 class="mt-12 text-2xl text-teal">Kontakt</h2>
      <p class="mt-4">
        E-Mail: <a href={`mailto:${SITE.supportEmail}`} class="underline">{SITE.supportEmail}</a><br />
        Kontaktformular: <a href={`${support}#contact`} class="underline">Hilfe &amp; FAQ</a>
      </p>

      <h2 class="mt-12 text-2xl text-teal">Streitschlichtung</h2>
      <p class="mt-4">
        Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
      </p>
    </div>
  </article>
</BaseLayout>
