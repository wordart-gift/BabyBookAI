---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PhoneShot from '../components/PhoneShot.astro';
import DownloadCta from '../components/DownloadCta.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqList from '../components/FaqList.astro';
import ToneSwatches from '../components/ToneSwatches.astro';
import { APP_ID, BOOK_ID, breadcrumbs, faqPage, mobileApplication, photoBook } from '../lib/schema';
import { BOY_FAQ } from '../data/faq';
import { SCREENS } from '../lib/photos';
import { BOOK } from '../config/site';

/*
 * Target: "baby boy photo album" (KD 0) and family: baby boy photo book,
 * baby boy first year album, personalized baby boy photo album. Same intent
 * as the girl page, its own copy. The only real photos we may use are of a
 * girl, so this page shows the app's screens instead of a spread.
 */

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Baby photo book', path: '/baby-photo-book/' },
  { name: 'Baby boy photo album', path: '/baby-boy-photo-album/' },
];

const steps = [
  { label: '5,437 photos', body: 'A year of camera roll: bath time, naps, the same grin forty times.' },
  { label: '157 kept', body: 'The sharpest of every moment, no bursts, no near-copies, no screenshots.' },
  { label: 'One book', body: 'A spread for each month, in order, ready to flip through and order.' },
];
---

<BaseLayout
  title="Baby Boy Photo Album Made From Your Camera Roll | BabyBookAI"
  description="A baby boy photo album in soft blue, made for you from the photos on your phone. BabyBookAI picks his best shots, sorts them by month and lays out a hardcover."
  schema={[breadcrumbs(trail), mobileApplication(), photoBook(), faqPage(BOY_FAQ)]}
  about={[BOOK_ID, APP_ID]}
  cta="baby-boy-photo-album"
>
  <Breadcrumbs items={trail} />

  <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pt-8 lg:grid-cols-[1.1fr_1fr] lg:pt-12">
    <div class="pb-12 lg:pb-20">
      <p class="font-extrabold uppercase tracking-wider text-teal">Baby boy photo album</p>
      <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">Baby boy photo album, made from your camera roll</h1>
      <p class="mt-6 max-w-xl text-xl text-ink">
        Give BabyBookAI his name and his birthday. It goes through the photos on your phone, keeps his best
        moments of every month and lays out a soft blue hardcover album. You just look through it.
      </p>
      <DownloadCta source="baby-boy-hero" class="mt-8" />
    </div>
    <div class="mx-auto flex w-full max-w-[30rem] items-end justify-center gap-5 self-end">
      <PhoneShot src={SCREENS.setup.src} alt={SCREENS.setup.alt} class="w-[48%]" eager />
      <PhoneShot src={SCREENS.selection.src} alt={SCREENS.selection.alt} class="w-[48%]" eager />
    </div>
  </section>

  <section class="band !mt-0" aria-labelledby="from-thousands">
    <div class="mx-auto max-w-6xl px-5">
      <h2 id="from-thousands" class="max-w-3xl text-4xl text-teal sm:text-5xl">From thousands of photos to one album</h2>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">
        The hard part of a baby boy photo album was never the printing. It is choosing. BabyBookAI does the choosing
        on your phone, so nothing is uploaded until you order.
      </p>
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class:list={['rounded-card p-7', i === 2 ? 'bg-teal text-surface' : 'bg-paper']}>
              <p class:list={['font-display text-3xl font-bold', i === 2 ? 'text-surface' : 'text-ink']}>{step.label}</p>
              <p class:list={['mt-3', i === 2 ? 'text-teal-wash' : 'text-ink-soft']}>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm text-ink-soft">The numbers are from one real year, the one on the screen above. Yours will differ.</p>
    </div>
  </section>

  <HowItWorks title="How to make a baby boy photo album" />

  <section class="band" aria-labelledby="his-colors">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2">
      <div>
        <p class="font-extrabold uppercase tracking-wider text-teal">Personalized</p>
        <h2 id="his-colors" class="mt-3 text-4xl text-teal sm:text-5xl">Soft blue, his name, your words</h2>
        <div class="mt-5 space-y-4 text-lg text-ink-soft">
          <p>
            His name and the best photo of his year go on the cover. Pick soft blue, or cream or pink if you prefer:
            the tone colors every page, with the lightest patterns of little birds, stars or clouds behind the photos.
          </p>
          <p>
            Every page comes with a short line you can keep or rewrite, and you can add a note of your own anywhere.
            Page one has the day he was born; the last page closes the year with a first birthday cake.
          </p>
        </div>
      </div>
      <ToneSwatches selected="blue" />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-20" aria-labelledby="details">
    <h2 id="details" class="text-4xl text-teal sm:text-5xl">The album itself</h2>
    <p class="mt-5 text-lg text-ink-soft">
      A square {BOOK.sizeIn} ({BOOK.sizeCm}) hardcover, matte cover, {BOOK.pagesMin} to {BOOK.pagesMax} pages on
      {' '}{BOOK.paper}. ${BOOK.priceUsd} with shipping included, printed on demand and sent to your door. Each photo
      goes only where it has the pixels to print sharp, so a small copy from a chat never ends up on the cover.
    </p>
    <p class="mt-6 text-ink-soft">
      Making one for a daughter? See the <a href="/baby-girl-photo-album/" class="font-bold text-teal underline underline-offset-4">baby girl photo album</a>.
      For the whole year, month by month, see the <a href="/first-year-photo-book/" class="font-bold text-teal underline underline-offset-4">first year photo book</a>.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-20" aria-labelledby="faq">
    <h2 id="faq" class="text-center text-4xl text-teal sm:text-5xl">Baby boy photo album questions</h2>
    <div class="mt-10">
      <FaqList faqs={BOY_FAQ} />
    </div>
  </section>
</BaseLayout>
