---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Stork from '../components/Stork.astro';
import { APP_ID, ORG_ID, breadcrumbs, mobileApplication } from '../lib/schema';
import { BOOK, PUBLISHER, SITE } from '../config/site';

/*
 * Who makes BabyBookAI and how, in facts that can be checked (the app's
 * CLAUDE.md). No founder story: nothing personal is published that Carlos has
 * not written himself.
 */

const trail = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];

const beliefs = [
  {
    title: 'The selection is the product',
    body: 'Anyone can print 200 photos. The value is picking the best 150 out of thousands and laying them out so the book looks composed, not generated.',
  },
  {
    title: 'Your photos stay on your phone',
    body: 'The photos are chosen on your phone. Nothing is uploaded to choose them; only the finished book is sent, when you order it, to be printed.',
  },
  {
    title: 'No homework',
    body: 'No weekly prompts, no journaling, no subscription. You took the photos already; the book is made from them, once, when you want it.',
  },
  {
    title: 'A book made to last',
    body: `A square ${BOOK.sizeIn} hardcover on ${BOOK.paper}, printed on demand by our print partner and shipped to your door.`,
  },
];
---

<BaseLayout
  title="About BabyBookAI | The Baby Photo Book That Makes Itself"
  description="BabyBookAI is a Photo-to-Text app that turns the photos on your phone into a printed photo book of your baby's first year. Who we are and how we make it."
  schema={[breadcrumbs(trail), mobileApplication()]}
  pageType="AboutPage"
  about={[ORG_ID, APP_ID]}
  cta="about"
>
  <Breadcrumbs items={trail} />

  <section class="mx-auto max-w-3xl px-5 pb-16 pt-8">
    <p class="font-extrabold uppercase tracking-wider text-teal">About</p>
    <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">A baby book for parents with no time to make one</h1>
    <div class="mt-6 space-y-5 text-xl text-ink">
      <p>
        In a baby’s first year, parents take thousands of photos. Very few of them end up in a book, because making
        one means hours of choosing, sorting and placing, with a baby in the house.
      </p>
      <p>
        {SITE.name} does that work for you. It reads the photos on your phone, keeps the best of every moment, sorts
        them month by month and lays out a hardcover book. You look through it, change what you like, and it is
        printed and sent to your door.
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="believe">
    <div class="mx-auto max-w-6xl px-5">
      <h2 id="believe" class="text-4xl text-teal sm:text-5xl">What we hold to</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {
          beliefs.map((b) => (
            <li class="rounded-card bg-paper p-7">
              <h3 class="text-2xl text-ink">{b.title}</h3>
              <p class="mt-3 text-ink-soft">{b.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="who">
    <div class="grid items-center gap-12 rounded-card bg-teal p-8 text-surface sm:p-12 lg:grid-cols-[auto_1fr]">
      <Stork size={150} swing={false} stage={false} class="mx-auto" />
      <div>
        <h2 id="who" class="text-4xl sm:text-5xl">A {PUBLISHER.name} product</h2>
        <p class="mt-5 max-w-2xl text-lg text-teal-wash">
          {SITE.name} is made by <a href={PUBLISHER.url} class="font-bold text-surface underline underline-offset-4">{PUBLISHER.name}</a>,
          a small company that makes personalized gifts from photos. Its logo is on the back cover of every book. Questions,
          ideas or a book that did not turn out right: write to
          <a href={`mailto:${SITE.supportEmail}`} class="font-bold text-surface underline underline-offset-4">{SITE.supportEmail}</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-10 text-center">
    <p class="text-lg text-ink-soft">
      See the <a href="/baby-photo-book/" class="font-bold text-teal underline underline-offset-4">baby photo book</a>,
      read the <a href="/privacy-policy/" class="font-bold text-teal underline underline-offset-4">privacy policy</a>, or
      get help on the <a href="/support/" class="font-bold text-teal underline underline-offset-4">support page</a>.
    </p>
  </section>
</BaseLayout>
