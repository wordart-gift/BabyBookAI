---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BookSpread from '../components/BookSpread.astro';
import FaqList from '../components/FaqList.astro';
import { article, breadcrumbs, faqPage } from '../lib/schema';
import { IDEAS_FAQ } from '../data/faq';
import { NOA_SPREAD } from '../lib/photos';

/*
 * Target: "baby photo book ideas" (traffic potential ~1,100: baby photo
 * album ideas, first year photo book ideas, baby book captions). The one
 * article in the plan. Informational intent, so it has to be useful on its
 * own; the product comes in where it honestly fits (choosing the photos)
 * and at the end. Nothing here may promise what the app does not do.
 */

const PUBLISHED = '2026-10-09';
const TITLE = 'Baby Photo Book Ideas: 25 Ways to Tell the First Year';
const DESCRIPTION =
  'Baby photo book ideas for the first year: ways to organize it, what to photograph, layouts that work, captions to borrow, and how many photos to pick.';

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Baby photo book', path: '/baby-photo-book/' },
  { name: 'Baby photo book ideas', path: '/baby-photo-book-ideas/' },
];

const toc = [
  { id: 'organize', label: 'Ways to organize the book' },
  { id: 'photograph', label: 'What to photograph while there’s time' },
  { id: 'layout', label: 'Page and layout ideas' },
  { id: 'captions', label: 'Caption ideas' },
  { id: 'choosing', label: 'How many photos, and which' },
  { id: 'gifts', label: 'Gift ideas' },
];

const organize = [
  {
    title: 'Month by month',
    body: 'The classic first year photo book: a two-page spread for each month, in the order it happened. Flipping through, you watch them grow. It also solves the hardest question, where a photo goes, by its date alone.',
  },
  {
    title: 'By firsts',
    body: 'First bath, first smile, first food, first steps, first haircut. Each gets its own page. Works well for a shorter book, or as a section after the months.',
  },
  {
    title: 'By season',
    body: 'Four chapters: the first snow, the first beach, the first fall leaves. Good when the photos cluster around trips and holidays.',
  },
  {
    title: 'The same spot, every month',
    body: 'The same chair, the same teddy for scale, photographed on the same day each month. If you started this, give the series its own spread at the end, side by side.',
  },
  {
    title: 'A day in the life',
    body: 'One ordinary day, morning to bedtime: bottle, nap, bath, the walk. The everyday is what you forget first.',
  },
  {
    title: 'The people who held them',
    body: 'A page each for grandparents, siblings, godparents, the friend who came every Sunday. The photos with other people in them are the ones a child looks for later.',
  },
];

const photograph = [
  'Hands and feet next to yours, every few months',
  'The nursery as it is, before it changes',
  'Mealtime mess, not just the clean-faced portraits',
  'Asleep in odd places: the car seat, the shoulder, the dog’s bed',
  'A wide shot of the room, not only close-ups',
  'You in the photo, too: hand the phone to someone else',
  'The outtakes: the blur, the yawn, the cry before the smile',
];

const layouts = [
  {
    title: 'One large photo, then a grid',
    body: 'The best photo of the month large on the left, five or six smaller ones on the right. It gives every spread a place to look first.',
  },
  {
    title: 'A full page for the photo that earns it',
    body: 'Not every month needs a grid. One great portrait alone on a page says more than six good ones.',
  },
  {
    title: 'Keep faces out of the fold',
    body: 'Most photo books are glued at the spine, so the middle of a spread curves away. Keep photos on their own page, and only cross the fold on purpose.',
  },
  {
    title: 'Mix close and wide',
    body: 'A close-up next to a close-up looks repetitive. Put a wide shot of the room or the park beside them.',
  },
  {
    title: 'Leave some paper',
    body: 'White space is what makes a page look designed instead of filled. A short line in a gap does more than another photo.',
  },
  {
    title: 'Choose square',
    body: 'Phone photos come upright and wide. On a square page both fit without one being cropped badly.',
  },
];

const captions = [
  'Dream big, little one',
  'Our little sunshine',
  'Cute, loud, and ready to rock',
  'You are so adorable',
  'Small hands, big plans',
  'Home is wherever you are',
  'The month you found your feet',
  'Ten fingers, ten toes, all heart',
  'Hello, world',
  'And then you were one',
];
---

<BaseLayout
  title={`${TITLE} | BabyBookAI`}
  description={DESCRIPTION}
  type="article"
  schema={[
    breadcrumbs(trail),
    article({ path: '/baby-photo-book-ideas/', headline: TITLE, description: DESCRIPTION, datePublished: PUBLISHED }),
    faqPage(IDEAS_FAQ),
  ]}
  cta="baby-photo-book-ideas"
>
  <Breadcrumbs items={trail} />

  <article class="mx-auto max-w-3xl px-5 pb-10 pt-8">
    <p class="font-extrabold uppercase tracking-wider text-teal">Ideas</p>
    <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">Baby photo book ideas: 25 ways to tell the first year</h1>
    <p class="mt-4 text-sm text-ink-soft">
      By the BabyBookAI team · <time datetime={PUBLISHED}>October 9, 2026</time>
    </p>
    <p class="mt-6 text-xl text-ink">
      By the first birthday most parents have thousands of photos of their baby and no idea where to start. These
      baby photo book ideas are the ones that work on paper: how to organize the year, what to photograph while there
      is still time, layouts that look designed, and captions you can borrow.
    </p>

    <nav aria-labelledby="toc-title" class="mt-10 rounded-card bg-surface p-6">
      <p id="toc-title" class="font-extrabold text-ink">In this article</p>
      <ol class="mt-3 list-decimal space-y-1 pl-6">
        {toc.map((item) => <li><a href={`#${item.id}`} class="text-teal underline underline-offset-4">{item.label}</a></li>)}
      </ol>
    </nav>

    <h2 id="organize" class="mt-16 scroll-mt-6 text-4xl text-teal">Ways to organize a baby photo book</h2>
    <p class="mt-4 text-lg text-ink-soft">
      Pick one spine for the book before choosing a single photo. It decides what goes in and what stays on the phone.
    </p>
    <ol class="mt-8 space-y-6">
      {
        organize.map((idea, i) => (
          <li class="border-l-4 border-teal-light pl-5">
            <h3 class="text-2xl text-ink">
              {i + 1}. {idea.title}
            </h3>
            <p class="mt-2 text-lg text-ink-soft">{idea.body}</p>
          </li>
        ))
      }
    </ol>

    <h2 id="photograph" class="mt-16 scroll-mt-6 text-4xl text-teal">What to photograph while there’s time</h2>
    <p class="mt-4 text-lg text-ink-soft">
      If the year is not over yet, these are the photos parents most often wish they had when they make the book:
    </p>
    <ul class="mt-6 space-y-3 text-lg">
      {
        photograph.map((idea, i) => (
          <li class="flex gap-3">
            <span class="font-display font-bold text-teal">{organize.length + i + 1}.</span>
            <span>{idea}</span>
          </li>
        ))
      }
    </ul>
  </article>

  <section class="band" aria-labelledby="layout">
    <div class="mx-auto max-w-6xl px-5">
      <h2 id="layout" class="max-w-3xl scroll-mt-6 text-4xl text-teal">Page and layout ideas</h2>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        The difference between a book that looks designed and one that looks dumped is mostly in a few rules.
      </p>
      <div class="mt-10 grid items-start gap-12 lg:grid-cols-[1fr_1.1fr]">
        <ol class="space-y-6">
          {
            layouts.map((idea, i) => (
              <li>
                <h3 class="text-2xl text-ink">
                  {organize.length + photograph.length + i + 1}. {idea.title}
                </h3>
                <p class="mt-2 text-ink-soft">{idea.body}</p>
              </li>
            ))
          }
        </ol>
        <BookSpread month="05 Months" dates="Sep 9 – Oct 8" photos={NOA_SPREAD} tone="pink">
          <figcaption class="mt-4 text-center text-sm text-ink-soft">
            One photo a page, nothing across the fold, room left on the paper.
          </figcaption>
        </BookSpread>
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-3xl px-5 py-10">
    <h2 id="captions" class="scroll-mt-6 text-4xl text-teal">Caption ideas for a baby photo book</h2>
    <p class="mt-4 text-lg text-ink-soft">
      {organize.length + photograph.length + layouts.length + 1}. Keep captions short: one line a page. Dates, places,
      nicknames and the details you will forget (the song that stopped the crying, the first word) beat long
      paragraphs. A few to borrow:
    </p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        captions.map((line) => (
          <li class="rounded-control bg-surface px-5 py-4 font-serif text-lg italic text-ink">
            “{line}”
          </li>
        ))
      }
    </ul>

    <h2 id="choosing" class="mt-16 scroll-mt-6 text-4xl text-teal">How many photos, and which ones</h2>
    <div class="mt-4 space-y-4 text-lg text-ink-soft">
      <p>
        {organize.length + photograph.length + layouts.length + 2}. <strong class="text-ink">Aim for 10 to 15 a
        month.</strong> A 30-page first year book holds about 150 photos comfortably. In one real year we looked at,
        157 photos were kept out of 5,437.
      </p>
      <p>
        {organize.length + photograph.length + layouts.length + 3}. <strong class="text-ink">Keep one of each
        moment.</strong> Phones take bursts; the book needs the sharpest frame, not all twelve.
      </p>
      <p>
        {organize.length + photograph.length + layouts.length + 4}. <strong class="text-ink">Mind the copies from
        chats.</strong> A photo saved from a messaging app is a smaller copy. It prints well small, but not across a
        full page or on the cover. If you have the original, use it.
      </p>
      <p>
        This part, the choosing, is where most baby books stall. It is the part{' '}
        <a href="/" class="font-bold text-teal underline underline-offset-4">BabyBookAI</a> does for you: it reads your
        camera roll on your phone, keeps the sharpest photo of every moment, sorts the year month by month and lays out
        the book, so you only look through it. See how the
        <a href="/first-year-photo-book/" class="font-bold text-teal underline underline-offset-4">first year photo book</a>
        is made.
      </p>
    </div>

    <h2 id="gifts" class="mt-16 scroll-mt-6 text-4xl text-teal">Gift ideas</h2>
    <ul class="mt-4 space-y-3 text-lg text-ink-soft">
      <li>
        <strong class="text-ink">{organize.length + photograph.length + layouts.length + 5}. For the first birthday.</strong>
        Close the book the week of the party and pass it around the table.
      </li>
      <li>
        <strong class="text-ink">{organize.length + photograph.length + layouts.length + 6}. For the grandparents.</strong>
        The gift they keep on the coffee table. A
        <a href="/baby-girl-photo-album/" class="font-bold text-teal underline underline-offset-4">baby girl photo album</a>
        in pink or a <a href="/baby-boy-photo-album/" class="font-bold text-teal underline underline-offset-4">baby boy photo album</a>
        in blue, with the baby’s name on the cover.
      </li>
    </ul>

    <div class="mt-12 rounded-card bg-teal p-8 text-surface">
      <p class="font-display text-3xl font-bold">Short on evenings?</p>
      <p class="mt-3 text-teal-wash">
        BabyBookAI turns the photos already on your phone into a hardcover book of the first year, in minutes.
      </p>
      <a
        href="#download"
        class="mt-6 inline-block rounded-control bg-amber px-6 py-3 font-extrabold text-ink shadow-[0_4px_0_var(--color-amber-deep)] hover:brightness-105"
        >Get the app</a
      >
    </div>
  </article>

  <section class="mx-auto max-w-3xl px-5 pb-20" aria-labelledby="faq">
    <h2 id="faq" class="text-center text-4xl text-teal sm:text-5xl">Baby photo book questions</h2>
    <div class="mt-10">
      <FaqList faqs={IDEAS_FAQ} />
    </div>
  </section>
</BaseLayout>
