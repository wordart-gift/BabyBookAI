---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | BabyBookAI"
  description="This page does not exist. Find the BabyBookAI baby photo book from here."
  noindex
  cta="404"
>
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <h1 class="text-4xl text-teal">This page wandered off</h1>
    <p class="mt-4 text-lg text-ink-soft">The link may be old. These are good places to start:</p>
    <ul class="mt-8 flex flex-col items-center gap-3 font-semibold">
      <li><a class="text-teal underline" href="/">Home</a></li>
      <li><a class="text-teal underline" href="/baby-photo-book/">Baby photo book</a></li>
      <li><a class="text-teal underline" href="/first-year-photo-book/">First year photo book</a></li>
    </ul>
  </section>
</BaseLayout>
