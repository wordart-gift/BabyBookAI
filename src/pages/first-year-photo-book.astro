---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BookSpread from '../components/BookSpread.astro';
import PhoneShot from '../components/PhoneShot.astro';
import DownloadCta from '../components/DownloadCta.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqList from '../components/FaqList.astro';
import { APP_ID, BOOK_ID, breadcrumbs, faqPage, mobileApplication, photoBook } from '../lib/schema';
import { FIRST_YEAR_FAQ } from '../data/faq';
import { NOA_SPREAD, SCREENS } from '../lib/photos';

/*
 * Target: "baby's first year photo book" (1,100/mo) and family: baby first
 * year photo album / book, first year photo book, monthly baby photo book.
 * The page that defines us: The Short Years and Duncan & Stone rank here.
 * Our angle against them: a weekly app is 52 small pieces of homework; this
 * is none.
 */

const trail = [
  { name: 'Home', path: '/' },
  { name: 'First year photo book', path: '/first-year-photo-book/' },
];

// What parents tend to photograph, not a developmental chart: the book
// follows the photos, and every baby keeps their own calendar.
const months = [
  { n: 'Page 1', moment: 'The day they were born' },
  { n: 'Month 1', moment: 'Coming home' },
  { n: 'Month 2', moment: 'The first real smiles' },
  { n: 'Month 3', moment: 'Tummy time' },
  { n: 'Month 4', moment: 'Laughing out loud' },
  { n: 'Month 5', moment: 'Grabbing everything' },
  { n: 'Month 6', moment: 'A first taste of food' },
  { n: 'Month 7', moment: 'Sitting up' },
  { n: 'Month 8', moment: 'On the move' },
  { n: 'Month 9', moment: 'Peekaboo' },
  { n: 'Month 10', moment: 'Pulling up to stand' },
  { n: 'Month 11', moment: 'Almost walking' },
  { n: 'Month 12', moment: 'The first birthday' },
  { n: 'Last page', moment: 'And then they were one' },
];
---

<BaseLayout
  title="Baby's First Year Photo Book You Don't Have to Make | BabyBookAI"
  description="A baby's first year photo book, month by month, made from the photos already on your phone. No weekly uploads: BabyBookAI picks, sorts and lays out the whole year."
  schema={[breadcrumbs(trail), mobileApplication(), photoBook(), faqPage(FIRST_YEAR_FAQ)]}
  about={[BOOK_ID, APP_ID]}
  cta="first-year-photo-book"
>
  <Breadcrumbs items={trail} />

  <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-8 lg:grid-cols-[1fr_1.05fr] lg:pt-12">
    <div>
      <p class="font-extrabold uppercase tracking-wider text-teal">Baby’s first year photo book</p>
      <h1 class="mt-3 text-[2.6rem] text-teal sm:text-6xl">Baby’s first year photo book you don’t have to make</h1>
      <p class="mt-6 max-w-xl text-xl text-ink">
        Twelve months, a spread for each, from the hospital to the cake. BabyBookAI builds it from the photos
        already on your phone, so there’s nothing to keep up with during the year.
      </p>
      <DownloadCta source="first-year-hero" class="mt-8" />
    </div>
    <BookSpread month="05 Months" dates="Sep 9 – Oct 8" photos={NOA_SPREAD} eager />
  </section>

  <section class="band" aria-labelledby="month-by-month">
    <div class="mx-auto max-w-6xl px-5">
      <p class="font-extrabold uppercase tracking-wider text-teal">Month by month</p>
      <h2 id="month-by-month" class="mt-3 max-w-3xl text-4xl text-teal sm:text-5xl">
        A monthly baby photo book, without the monthly photo shoot
      </h2>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft">
        No milestone cards, no setting up the same shot on the same blanket every month. The book follows the
        photos you took anyway, in the order you took them. Every baby keeps their own calendar.
      </p>
      <ol class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
        {
          months.map((m, i) => (
            <li
              class:list={[
                'rounded-control p-4',
                i === 0 || i === months.length - 1 ? 'bg-amber-wash' : 'bg-paper',
              ]}
            >
              <p class="text-xs font-extrabold uppercase tracking-wider text-teal">{m.n}</p>
              <p class="mt-1 font-bold leading-snug">{m.moment}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="unfinished">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 id="unfinished" class="text-4xl text-teal sm:text-5xl">Why most first year books never get finished</h2>
        <div class="mt-6 space-y-5 text-lg text-ink-soft">
          <p>
            A fill-in baby book asks you to print, glue and write every month. A weekly baby book app asks for a few
            minutes every week, fifty-two weeks in a row. Neither sounds like much, until it’s month five, you’re
            sleeping in two-hour shifts, and the book is three weeks behind.
          </p>
          <p>
            The photos, though, kept coming. You never stopped taking them. BabyBookAI starts there: when the year
            is over, it reads your camera roll and makes the book from what you already have. Your part takes
            minutes, once.
          </p>
        </div>
      </div>
      <dl class="grid content-start gap-4 sm:grid-cols-3 lg:grid-cols-1">
        <div class="rounded-card bg-surface p-6">
          <dt class="font-bold text-ink-soft">Fill-in memory book</dt>
          <dd class="mt-1 font-display text-3xl font-bold text-ink">Every month</dd>
        </div>
        <div class="rounded-card bg-surface p-6">
          <dt class="font-bold text-ink-soft">Weekly baby book app</dt>
          <dd class="mt-1 font-display text-3xl font-bold text-ink">52 weeks</dd>
        </div>
        <div class="rounded-card bg-teal p-6 text-surface">
          <dt class="font-bold text-teal-wash">BabyBookAI</dt>
          <dd class="mt-1 font-display text-3xl font-bold">Once, in minutes</dd>
        </div>
      </dl>
    </div>
  </section>

  <HowItWorks title="How the first year photo book gets made" />

  <section class="band" aria-labelledby="birthday">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 md:grid-cols-2">
      <PhoneShot src={SCREENS.setup.src} alt={SCREENS.setup.alt} class="mx-auto w-[15rem] self-end" />
      <div>
        <h2 id="birthday" class="text-4xl text-teal sm:text-5xl">In time for the first birthday</h2>
        <p class="mt-5 text-lg text-ink-soft">
          You choose the dates, so the book can close the week of the party, or the day after it. Thin months are
          fine: the layout follows the photos, and a month with one great shot gets a page made for one. Want to
          go past the first year? A book can cover up to 18 months.
        </p>
        <p class="mt-6">
          <a href="/baby-photo-book/" class="font-extrabold text-teal underline underline-offset-4">See the baby photo book in detail</a>
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-20" aria-labelledby="faq">
    <h2 id="faq" class="text-center text-4xl text-teal sm:text-5xl">First year photo book questions</h2>
    <div class="mt-10">
      <FaqList faqs={FIRST_YEAR_FAQ} />
    </div>
  </section>
</BaseLayout>
